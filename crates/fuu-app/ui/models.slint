// Data structures shared between UI files.

export struct AccountItem {
    id: string,
    name: string,
    email: string,
    initial: string,
    hue: int,
}

export struct FolderItem {
    path: string,
    display: string,
    // 0 inbox, 1 drafts, 2 sent, 3 archive, 4 junk, 5 trash, 6 other
    role: int,
    selectable: bool,
}
