// Settings, shown as a tab in the right pane.

import { Theme } from "theme.slint";
import { Divider, Icon, Avatar, MenuRow, SecondaryButton } from "components.slint";
import { AccountItem } from "models.slint";

/// iOS-style switch with an animated knob.
export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: root.checked ? Theme.accent : Theme.border;
    opacity: root.enabled ? 1 : 0.5;
    animate background { duration: 160ms; easing: ease-out; }
    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    Rectangle {
        x: root.checked ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000033;
        animate x { duration: 160ms; easing: ease-out; }
    }
}

/// Segmented control with a sliding indicator.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    callback changed-to(int);
    property <length> segment: (root.width - 4px) / max(1, root.options.length);
    height: 30px;
    width: 92px * root.options.length;
    border-radius: Theme.radius-m;
    background: Theme.field;
    Rectangle {
        x: 2px + root.selected * root.segment;
        y: 2px;
        width: root.segment;
        height: parent.height - 4px;
        border-radius: Theme.radius-s;
        background: Theme.raised;
        drop-shadow-blur: 4px;
        drop-shadow-color: #0000001f;
        animate x { duration: 180ms; easing: ease-out; }
    }
    for option[i] in root.options: Rectangle {
        x: 2px + i * root.segment;
        width: root.segment;
        TouchArea {
            clicked => {
                root.selected = i;
                root.changed-to(i);
            }
        }
        Text {
            text: option;
            font-size: Theme.font-s;
            color: i == root.selected ? Theme.text : Theme.text-muted;
            font-weight: i == root.selected ? 600 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    min-height: 56px;
    HorizontalLayout {
        spacing: 24px;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text { text: root.title; font-size: Theme.font-m; color: Theme.text; }
            if root.description != "": Text { text: root.description; font-size: Theme.font-s; color: Theme.text-faint; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

component PageTitle inherits Text {
    font-size: Theme.font-xl;
    font-weight: 600;
    color: Theme.text;
}

component NavLink inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    height: 32px;
    border-radius: Theme.radius-m;
    background: root.selected ? Theme.selected : area.has-hover ? Theme.hover : transparent;
    animate background { duration: 80ms; }
    area := TouchArea { clicked => { root.clicked(); } }
    Text {
        x: 12px;
        text: root.label;
        font-size: Theme.font-m;
        color: root.selected ? Theme.text : Theme.text-muted;
        font-weight: root.selected ? 600 : 400;
        vertical-alignment: center;
    }
}

export component SettingsView inherits Rectangle {
    in-out property <int> page;
    in-out property <int> theme-mode;   // 0 system, 1 light, 2 dark
    in-out property <bool> compose-html: true;
    // Default mail app (mailto: links): status line and whether Fuu is it.
    in property <string> default-mail-status;
    // Updates (src/update.rs): status line, start-up check, manual check.
    in property <string> update-status;
    in-out property <bool> check-updates: true;
    in property <bool> update-checking;
    in property <string> app-version;
    callback check-update-now();
    in property <[string]> language-names;
    in-out property <int> language-index;
    in property <bool> is-default-mail-app;
    callback make-default-mail-app();
    in-out property <string> signature-text;
    in-out property <bool> signature-enabled;
    // Accounts to pick the signature of, and the chosen one.
    in property <[string]> signature-accounts;
    in-out property <int> signature-account;
    in property <[AccountItem]> accounts;
    callback add-account();
    callback remove-account(string);
    callback edit-account(string);

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 40px;
        padding-top: 26px;
        spacing: 36px;

        VerticalLayout {
            width: 176px;
            spacing: 2px;
            alignment: start;
            NavLink { label: @tr("General"); selected: root.page == 0; clicked => { root.page = 0; } }
            NavLink { label: @tr("Accounts"); selected: root.page == 1; clicked => { root.page = 1; } }
            NavLink { label: @tr("Signature"); selected: root.page == 2; clicked => { root.page = 2; } }
            NavLink { label: @tr("Privacy"); selected: root.page == 3; clicked => { root.page = 3; } }
            NavLink { label: @tr("Language"); selected: root.page == 5; clicked => { root.page = 5; } }
            NavLink { label: @tr("About"); selected: root.page == 4; clicked => { root.page = 4; } }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            max-width: 560px;
            alignment: start;
            spacing: 4px;

            if root.page == 0: VerticalLayout {
                spacing: 4px;
                PageTitle { text: @tr("General"); }
                Rectangle { height: 14px; }
                SettingRow {
                    title: @tr("Theme");
                    description: @tr("Follow the system, or always use the light or dark look.");
                    Segmented { options: [@tr("System"), @tr("Light"), @tr("Dark")]; selected <=> root.theme-mode; }
                }
                Divider { height: 1px; }
                SettingRow {
                    title: @tr("Send HTML mail");
                    description: @tr("Sends an HTML version made from the text alongside the plain text (tidier quotes, signature and links). Turn off to send plain text only.");
                    Toggle { checked <=> root.compose-html; }
                }
                Divider { height: 1px; }
                SettingRow {
                    title: @tr("Default mail app");
                    description: root.default-mail-status;
                    if !root.is-default-mail-app: SecondaryButton {
                        text: @tr("Make Fuu the default");
                        clicked => { root.make-default-mail-app(); }
                    }
                }
                Divider { height: 1px; }
                SettingRow {
                    title: @tr("Check for updates at start-up");
                    description: root.update-status != "" ? root.update-status
                        : @tr("Looks at the GitHub releases and tells you about a new version. Updates are installed only after their signature is verified.");
                    Toggle { checked <=> root.check-updates; }
                }
                HorizontalLayout {
                    alignment: start;
                    padding-top: 4px;
                    SecondaryButton {
                        text: root.update-checking ? @tr("Checking…") : @tr("Check now");
                        clicked => { if (!root.update-checking) { root.check-update-now(); } }
                    }
                }
            }

            if root.page == 1: VerticalLayout {
                spacing: 6px;
                PageTitle { text: @tr("Accounts"); }
                Rectangle { height: 10px; }
                if root.accounts.length == 0: Text { text: @tr("No accounts yet."); font-size: Theme.font-m; color: Theme.text-faint; }
                for account in root.accounts: Rectangle {
                    height: 60px;
                    border-radius: Theme.radius-l;
                    background: Theme.field;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 10px;
                        spacing: 12px;
                        Avatar { initials: account.initial; hue: account.hue; size: 30px; y: (parent.height - self.height) / 2; }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: account.name; font-size: Theme.font-m; font-weight: 600; color: Theme.text; overflow: elide; }
                            Text { text: account.email; font-size: Theme.font-s; color: Theme.text-faint; overflow: elide; }
                        }
                        Rectangle {
                            width: edit-label.preferred-width + 20px;
                            height: 30px;
                            y: (parent.height - self.height) / 2;
                            border-radius: Theme.radius-m;
                            background: edit-area.has-hover ? Theme.hover : transparent;
                            edit-area := TouchArea { clicked => { root.edit-account(account.id); } }
                            edit-label := Text { text: @tr("Edit"); font-size: Theme.font-s; color: edit-area.has-hover ? Theme.text : Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            width: remove-label.preferred-width + 20px;
                            height: 30px;
                            y: (parent.height - self.height) / 2;
                            border-radius: Theme.radius-m;
                            background: remove-area.has-hover ? Theme.hover : transparent;
                            remove-area := TouchArea { clicked => { root.remove-account(account.id); } }
                            remove-label := Text { text: @tr("Delete"); font-size: Theme.font-s; color: remove-area.has-hover ? Theme.close-hover : Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
                Rectangle { height: 4px; }
                MenuRow { icon: @image-url("icons/plus.svg"); label: @tr("Add account"); clicked => { root.add-account(); } }
            }

            if root.page == 2: VerticalLayout {
                spacing: 4px;
                PageTitle { text: @tr("Signature"); }
                Rectangle { height: 14px; }
                if root.signature-accounts.length == 0: Text {
                    text: @tr("Add an account to give each account its own signature.");
                    font-size: Theme.font-m;
                    color: Theme.text-faint;
                    wrap: word-wrap;
                }
                if root.signature-accounts.length > 0: VerticalLayout {
                    spacing: 4px;
                    // Several accounts: pick whose signature to edit.
                    if root.signature-accounts.length > 1: VerticalLayout {
                        spacing: 2px;
                        padding-bottom: 10px;
                        Text { text: @tr("Accounts"); font-size: Theme.font-m; color: Theme.text; }
                        Text { text: @tr("Each account keeps its own signature."); font-size: Theme.font-s; color: Theme.text-faint; }
                        Rectangle { height: 6px; }
                        for label[i] in root.signature-accounts: Rectangle {
                            height: 34px;
                            border-radius: Theme.radius-m;
                            background: i == root.signature-account ? Theme.selected : pick.has-hover ? Theme.hover : transparent;
                            pick := TouchArea { clicked => { root.signature-account = i; } }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 4px;
                                    background: i == root.signature-account ? Theme.accent : transparent;
                                }
                                Text {
                                    text: label;
                                    font-size: Theme.font-m;
                                    font-weight: i == root.signature-account ? 600 : 400;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                        Divider { height: 1px; }
                    }
                    SettingRow {
                        title: @tr("Add the signature to new messages");
                        description: @tr("Inserted below the text of every new message, reply and forward. Changes are saved straight away.");
                        Toggle { checked <=> root.signature-enabled; }
                    }
                    Rectangle { height: 8px; }
                    // Multi-line field in Fuu's own style (std TextEdit draws nothing
                    // with this theme).
                    Rectangle {
                        height: 160px;
                        border-radius: Theme.radius-l;
                        background: Theme.field;
                        border-width: 1px;
                        border-color: signature-input.has-focus ? Theme.accent : Theme.border;
                        opacity: root.signature-enabled ? 1 : 0.45;
                        animate opacity { duration: 160ms; }
                        clip: true;
                        signature-input := TextInput {
                            x: 12px;
                            y: 10px;
                            width: parent.width - 24px;
                            height: parent.height - 20px;
                            text <=> root.signature-text;
                            enabled: root.signature-enabled;
                            single-line: false;
                            wrap: word-wrap;
                            color: Theme.text;
                            font-size: Theme.font-m;
                        }
                        if root.signature-text == "" && !signature-input.has-focus: Text {
                            x: 12px;
                            y: 10px;
                            text: @tr("e.g. Alex Taylor\nExample Ltd.");
                            color: Theme.text-faint;
                            font-size: Theme.font-m;
                        }
                    }
                }
            }

            if root.page == 3: VerticalLayout {
                spacing: 4px;
                PageTitle { text: @tr("Privacy"); }
                Rectangle { height: 14px; }
                SettingRow {
                    title: @tr("Do not load remote images");
                    description: @tr("Blocked by default; Fuu fetches them only when you allow it for a message. Tracking pixels are never fetched.");
                    Toggle { checked: true; enabled: false; }
                }
                Divider { height: 1px; }
                SettingRow {
                    title: @tr("No remote CSS or scripts");
                    description: @tr("Only CSS known to be safe is applied to HTML mail. JavaScript never runs.");
                    Toggle { checked: true; enabled: false; }
                }
                Divider { height: 1px; }
                SettingRow {
                    title: @tr("Confirm before opening links");
                    description: @tr("Shows the real URL, then opens it in your default browser.");
                    Toggle { checked: true; enabled: false; }
                }
            }

            if root.page == 5: VerticalLayout {
                spacing: 2px;
                PageTitle { text: @tr("Language"); }
                Text {
                    text: @tr("Translations other than Japanese are made by AI. Corrections are welcome on GitHub.");
                    font-size: Theme.font-s;
                    color: Theme.text-faint;
                    wrap: word-wrap;
                }
                Rectangle { height: 10px; }
                for name[i] in root.language-names: Rectangle {
                    height: 34px;
                    border-radius: Theme.radius-m;
                    background: i == root.language-index ? Theme.selected : lang-area.has-hover ? Theme.hover : transparent;
                    lang-area := TouchArea { clicked => { root.language-index = i; } }
                    HorizontalLayout {
                        padding-left: 12px;
                        spacing: 10px;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: i == root.language-index ? Theme.accent : transparent;
                        }
                        Text {
                            text: name;
                            font-size: Theme.font-m;
                            font-weight: i == root.language-index ? 600 : 400;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.page == 4: VerticalLayout {
                spacing: 8px;
                Image {
                    source: @image-url("../icons/app/fuu.svg");
                    width: 88px;
                    height: 88px;
                    x: -8px;
                    image-rendering: smooth;
                }
                PageTitle { text: "Fuu (封)"; }
                Text { text: @tr("Version {}", root.app-version); font-size: Theme.font-m; color: Theme.text-muted; }
                Rectangle { height: 8px; }
                Text { text: @tr("A minimal mail client with just what you need."); font-size: Theme.font-m; color: Theme.text; wrap: word-wrap; }
                Text { text: @tr("Distributed under the GNU General Public License v3.0."); font-size: Theme.font-s; color: Theme.text-faint; wrap: word-wrap; }
                Text { text: @tr("Built with Slint (GPLv3), Blitz (MIT / Apache-2.0) and other open-source software."); font-size: Theme.font-s; color: Theme.text-faint; wrap: word-wrap; }
            }
        }
    }
}
