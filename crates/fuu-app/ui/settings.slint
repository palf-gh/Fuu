// Settings, shown as a tab in the right pane.

import { TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Divider, Icon, Avatar, MenuRow, SecondaryButton } from "components.slint";
import { AccountItem } from "models.slint";

/// iOS-style switch with an animated knob.
export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: root.checked ? Theme.accent : Theme.border;
    opacity: root.enabled ? 1 : 0.5;
    animate background { duration: 160ms; easing: ease-out; }
    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    Rectangle {
        x: root.checked ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000033;
        animate x { duration: 160ms; easing: ease-out; }
    }
}

/// Segmented control with a sliding indicator.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    callback changed-to(int);
    property <length> segment: (root.width - 4px) / max(1, root.options.length);
    height: 30px;
    width: 92px * root.options.length;
    border-radius: Theme.radius-m;
    background: Theme.field;
    Rectangle {
        x: 2px + root.selected * root.segment;
        y: 2px;
        width: root.segment;
        height: parent.height - 4px;
        border-radius: Theme.radius-s;
        background: Theme.raised;
        drop-shadow-blur: 4px;
        drop-shadow-color: #0000001f;
        animate x { duration: 180ms; easing: ease-out; }
    }
    for option[i] in root.options: Rectangle {
        x: 2px + i * root.segment;
        width: root.segment;
        TouchArea {
            clicked => {
                root.selected = i;
                root.changed-to(i);
            }
        }
        Text {
            text: option;
            font-size: Theme.font-s;
            color: i == root.selected ? Theme.text : Theme.text-muted;
            font-weight: i == root.selected ? 600 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    min-height: 56px;
    HorizontalLayout {
        spacing: 24px;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text { text: root.title; font-size: Theme.font-m; color: Theme.text; }
            if root.description != "": Text { text: root.description; font-size: Theme.font-s; color: Theme.text-faint; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

component PageTitle inherits Text {
    font-size: Theme.font-xl;
    font-weight: 600;
    color: Theme.text;
}

component NavLink inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    height: 32px;
    border-radius: Theme.radius-m;
    background: root.selected ? Theme.selected : area.has-hover ? Theme.hover : transparent;
    animate background { duration: 80ms; }
    area := TouchArea { clicked => { root.clicked(); } }
    Text {
        x: 12px;
        text: root.label;
        font-size: Theme.font-m;
        color: root.selected ? Theme.text : Theme.text-muted;
        font-weight: root.selected ? 600 : 400;
        vertical-alignment: center;
    }
}

export component SettingsView inherits Rectangle {
    in-out property <int> page;
    in-out property <int> theme-mode;   // 0 system, 1 light, 2 dark
    in-out property <bool> compose-html: true;
    // Default mail app (mailto: links): status line and whether Fuu is it.
    in property <string> default-mail-status;
    in property <bool> is-default-mail-app;
    callback make-default-mail-app();
    in-out property <string> signature-text;
    in-out property <bool> signature-enabled;
    in property <[AccountItem]> accounts;
    callback add-account();
    callback remove-account(string);

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 40px;
        padding-top: 26px;
        spacing: 36px;

        VerticalLayout {
            width: 176px;
            spacing: 2px;
            alignment: start;
            NavLink { label: "一般"; selected: root.page == 0; clicked => { root.page = 0; } }
            NavLink { label: "アカウント"; selected: root.page == 1; clicked => { root.page = 1; } }
            NavLink { label: "署名"; selected: root.page == 2; clicked => { root.page = 2; } }
            NavLink { label: "プライバシー"; selected: root.page == 3; clicked => { root.page = 3; } }
            NavLink { label: "このアプリについて"; selected: root.page == 4; clicked => { root.page = 4; } }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            max-width: 560px;
            alignment: start;
            spacing: 4px;

            if root.page == 0: VerticalLayout {
                spacing: 4px;
                PageTitle { text: "一般"; }
                Rectangle { height: 14px; }
                SettingRow {
                    title: "テーマ";
                    description: "システムに合わせるか、明るい／暗い表示に固定します。";
                    Segmented { options: ["システム", "ライト", "ダーク"]; selected <=> root.theme-mode; }
                }
                Divider { height: 1px; }
                SettingRow {
                    title: "HTML メールで送信";
                    description: "本文から HTML 版を作り、テキスト版と一緒に送ります（引用・署名・リンクを整えて表示）。オフにするとテキストのみで送ります。";
                    Toggle { checked <=> root.compose-html; }
                }
                Divider { height: 1px; }
                SettingRow {
                    title: "既定のメールアプリ";
                    description: root.default-mail-status;
                    if !root.is-default-mail-app: SecondaryButton {
                        text: "Fuu を既定にする";
                        clicked => { root.make-default-mail-app(); }
                    }
                }
            }

            if root.page == 1: VerticalLayout {
                spacing: 6px;
                PageTitle { text: "アカウント"; }
                Rectangle { height: 10px; }
                if root.accounts.length == 0: Text { text: "アカウントはまだありません。"; font-size: Theme.font-m; color: Theme.text-faint; }
                for account in root.accounts: Rectangle {
                    height: 60px;
                    border-radius: Theme.radius-l;
                    background: Theme.field;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 10px;
                        spacing: 12px;
                        Avatar { initials: account.initial; hue: account.hue; size: 30px; y: (parent.height - self.height) / 2; }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: account.name; font-size: Theme.font-m; font-weight: 600; color: Theme.text; overflow: elide; }
                            Text { text: account.email; font-size: Theme.font-s; color: Theme.text-faint; overflow: elide; }
                        }
                        Rectangle {
                            width: remove-label.preferred-width + 20px;
                            height: 30px;
                            y: (parent.height - self.height) / 2;
                            border-radius: Theme.radius-m;
                            background: remove-area.has-hover ? Theme.hover : transparent;
                            remove-area := TouchArea { clicked => { root.remove-account(account.id); } }
                            remove-label := Text { text: "削除"; font-size: Theme.font-s; color: remove-area.has-hover ? Theme.close-hover : Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
                Rectangle { height: 4px; }
                MenuRow { icon: @image-url("icons/plus.svg"); label: "アカウントを追加"; clicked => { root.add-account(); } }
            }

            if root.page == 2: VerticalLayout {
                spacing: 4px;
                PageTitle { text: "署名"; }
                Rectangle { height: 14px; }
                SettingRow {
                    title: "新規メッセージに署名を入れる";
                    description: "作成・返信・転送のたびに、本文の下へ「-- 」区切り付きで挿入します。";
                    Toggle { checked <=> root.signature-enabled; }
                }
                Rectangle { height: 8px; }
                Rectangle {
                    height: 160px;
                    opacity: root.signature-enabled ? 1 : 0.45;
                    animate opacity { duration: 160ms; }
                    TextEdit { text <=> root.signature-text; wrap: word-wrap; enabled: root.signature-enabled; }
                }
            }

            if root.page == 3: VerticalLayout {
                spacing: 4px;
                PageTitle { text: "プライバシー"; }
                Rectangle { height: 14px; }
                SettingRow {
                    title: "外部画像を読み込まない";
                    description: "既定でブロックし、メールごとに許可したときだけ Fuu が取得します。追跡ピクセルは許可しても取得しません。";
                    Toggle { checked: true; enabled: false; }
                }
                Divider { height: 1px; }
                SettingRow {
                    title: "外部 CSS とスクリプトを使わない";
                    description: "HTML メールの CSS は安全と確認した範囲だけ適用します。JavaScript は実行しません。";
                    Toggle { checked: true; enabled: false; }
                }
                Divider { height: 1px; }
                SettingRow {
                    title: "リンクを開く前に確認する";
                    description: "実際の URL を表示してから、OS の標準ブラウザで開きます。";
                    Toggle { checked: true; enabled: false; }
                }
            }

            if root.page == 4: VerticalLayout {
                spacing: 8px;
                Image {
                    source: @image-url("../icons/app/fuu.svg");
                    width: 88px;
                    height: 88px;
                    x: -8px;
                    image-rendering: smooth;
                }
                PageTitle { text: "Fuu (封)"; }
                Text { text: "バージョン 0.1.0-alpha.1（アルファ版）"; font-size: Theme.font-m; color: Theme.text-muted; }
                Rectangle { height: 8px; }
                Text { text: "最小限の機能に絞った、ミニマルなメールクライアント。"; font-size: Theme.font-m; color: Theme.text; wrap: word-wrap; }
                Text { text: "GNU General Public License v3.0 で配布しています。"; font-size: Theme.font-s; color: Theme.text-faint; wrap: word-wrap; }
                Text { text: "Slint（GPLv3）、Blitz（MIT / Apache-2.0）ほかのオープンソースソフトウェアを使用しています。"; font-size: Theme.font-s; color: Theme.text-faint; wrap: word-wrap; }
            }
        }
    }
}
