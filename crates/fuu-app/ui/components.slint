// Reusable building blocks for Fuu's UI.

import { Theme } from "theme.slint";

export component Divider inherits Rectangle {
    background: Theme.hairline;
}

export component Icon inherits Image {
    in property <color> tint: Theme.text-muted;
    width: 17px;
    height: 17px;
    colorize: root.tint;
    image-rendering: smooth;
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    in property <length> size: 30px;
    in property <length> icon-size: 17px;
    in property <color> tint: Theme.text-faint;
    callback clicked;
    width: root.size;
    height: root.size;
    border-radius: Theme.radius-m;
    background: !root.enabled ? transparent : area.pressed ? Theme.pressed : area.has-hover ? Theme.hover : transparent;
    animate background { duration: 80ms; }
    area := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Icon {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        tint: !root.enabled ? Theme.text-faint.with-alpha(0.4) : area.has-hover ? Theme.text : root.tint;
    }
}

export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    callback clicked;
    height: 34px;
    min-width: layout.preferred-width;
    border-radius: Theme.radius-m;
    background: area.pressed ? Theme.accent-hover.darker(0.08) : area.has-hover ? Theme.accent-hover : Theme.accent;
    animate background { duration: 80ms; }
    area := TouchArea { clicked => { root.clicked(); } }
    layout := HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        spacing: 8px;
        alignment: center;
        if root.has-icon: Icon { source: root.icon; width: 15px; height: 15px; tint: Theme.on-accent; y: (parent.height - self.height) / 2; }
        Text { text: root.text; color: Theme.on-accent; font-size: Theme.font-m; font-weight: 600; vertical-alignment: center; }
    }
}

export component SecondaryButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 34px;
    min-width: layout.preferred-width;
    border-radius: Theme.radius-m;
    background: area.pressed ? Theme.pressed : area.has-hover ? Theme.hover : Theme.field;
    area := TouchArea { clicked => { root.clicked(); } }
    layout := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text { text: root.text; color: Theme.text; font-size: Theme.font-m; vertical-alignment: center; horizontal-alignment: center; }
    }
}

export component Avatar inherits Rectangle {
    in property <string> initials;
    in property <int> hue;
    in property <length> size: 24px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: Theme.avatars[Math.mod(root.hue, 8)];
    Text {
        text: root.initials;
        color: #ffffff;
        font-size: root.size * 0.42;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> count;
    in property <bool> selected;
    callback clicked;
    height: 32px;
    border-radius: Theme.radius-m;
    background: root.selected ? Theme.selected : area.has-hover ? Theme.hover : transparent;
    animate background { duration: 80ms; }
    area := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 11px;
        Icon {
            source: root.icon;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            tint: root.selected ? Theme.text : Theme.text-faint;
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            color: root.selected ? Theme.text : Theme.text-muted;
            font-weight: root.selected ? 600 : 400;
            font-size: Theme.font-m;
        }
        Text {
            text: root.count;
            vertical-alignment: center;
            color: root.selected ? Theme.text-muted : Theme.text-faint;
            font-size: Theme.font-s;
        }
    }
}

export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "検索";
    height: 30px;
    clip: true;
    border-radius: Theme.radius-m;
    background: input.has-focus ? Theme.raised : Theme.field;
    border-width: input.has-focus ? 1px : 0px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Icon { source: @image-url("icons/search.svg"); width: 14px; height: 14px; y: (parent.height - self.height) / 2; tint: Theme.text-faint; }
        Rectangle {
            input := TextInput {
                text <=> root.text;
                color: Theme.text;
                font-size: Theme.font-s;
                vertical-alignment: center;
                single-line: true;
            }
            Text {
                visible: root.text == "" && !input.has-focus;
                text: root.placeholder;
                color: Theme.text-faint;
                font-size: Theme.font-s;
                vertical-alignment: center;
                x: 0;
            }
        }
    }
}

/// Borderless labelled single-line field used in the composer.
export component ComposeField inherits Rectangle {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> text;
    in property <length> inset: 24px;
    height: 44px;
    HorizontalLayout {
        padding-left: root.inset;
        padding-right: root.inset;
        spacing: 12px;
        Text { text: root.label; width: 48px; color: Theme.text-faint; font-size: Theme.font-m; vertical-alignment: center; }
        Rectangle {
            input := TextInput {
                text <=> root.text;
                color: Theme.text;
                font-size: Theme.font-m;
                vertical-alignment: center;
                single-line: true;
            }
            Text {
                visible: root.text == "" && !input.has-focus;
                text: root.placeholder;
                color: Theme.text-faint;
                font-size: Theme.font-m;
                vertical-alignment: center;
                x: 0;
            }
        }
    }
    Divider { y: parent.height - 1px; height: 1px; x: root.inset; width: parent.width - 2 * root.inset; }
}

/// A plain menu row for popups.
export component MenuRow inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <string> label;
    in property <string> trailing;
    callback clicked;
    height: 32px;
    border-radius: Theme.radius-s;
    background: area.has-hover ? Theme.hover : transparent;
    area := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        if root.has-icon: Icon { source: root.icon; width: 15px; height: 15px; y: (parent.height - self.height) / 2; }
        Text { text: root.label; color: Theme.text; font-size: Theme.font-m; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Text { text: root.trailing; color: Theme.text-faint; font-size: Theme.font-s; vertical-alignment: center; }
    }
}

export component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> detail;
    in property <string> confirm-label: "OK";
    in property <bool> show-cancel: true;
    callback confirmed;
    callback cancelled;
    property <bool> shown;
    init => { self.shown = true; }
    background: root.shown ? Theme.scrim : Theme.scrim.transparentize(1);
    animate background { duration: 160ms; easing: ease-out; }
    TouchArea { }  // swallow clicks behind the card
    Rectangle {
        y: (parent.height - self.height) / 2 + (root.shown ? 0px : 10px);
        opacity: root.shown ? 1 : 0;
        animate y, opacity { duration: 200ms; easing: ease-out; }
        width: min(parent.width - 48px, 420px);
        height: layout.preferred-height;
        border-radius: Theme.radius-xl;
        background: Theme.raised;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 10px;
        drop-shadow-color: #00000030;
        layout := VerticalLayout {
            padding: 24px;
            spacing: 10px;
            Text { text: root.title; font-size: Theme.font-l; font-weight: 600; color: Theme.text; }
            Text { text: root.body; wrap: word-wrap; color: Theme.text-muted; font-size: Theme.font-m; }
            if root.detail != "": Rectangle {
                height: detail-text.preferred-height + 16px;
                border-radius: Theme.radius-m;
                background: Theme.field;
                detail-text := Text {
                    x: 10px;
                    width: parent.width - 20px;
                    text: root.detail;
                    wrap: word-wrap;
                    color: Theme.text;
                    font-size: Theme.font-s;
                    vertical-alignment: center;
                }
            }
            Rectangle { height: 8px; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                if root.show-cancel: SecondaryButton { text: "キャンセル"; clicked => { root.cancelled(); } }
                PrimaryButton { text: root.confirm-label; clicked => { root.confirmed(); } }
            }
        }
    }
}

/// Windows-style caption button (minimise / maximise / close).
export component CaptionButton inherits Rectangle {
    in property <image> icon;
    in property <bool> is-close;
    callback clicked;
    width: 46px;
    background: area.has-hover ? (root.is-close ? Theme.close-hover : Theme.hover) : transparent;
    area := TouchArea { clicked => { root.clicked(); } }
    Icon {
        source: root.icon;
        width: 14px;
        height: 14px;
        tint: area.has-hover && root.is-close ? #ffffff : Theme.text-muted;
    }
}

/// One tab in the title-bar tab strip (a place: mailbox, message, draft or settings).
/// The outer element keeps its layout slot; the visible chip slides by `shift`
/// while tabs are being reordered.
export component Tab inherits Rectangle {
    in property <string> title;
    in property <int> kind;   // 0 mail, 1 compose, 2 settings
    in property <bool> active;
    in property <bool> unseen;
    in property <length> shift;
    in property <bool> being-dragged;
    // Plays the shrink-out before Rust removes the tab.
    in property <bool> closing;
    callback activated;
    callback closed;
    // offset of the pointer since press, and the slot width (tab + spacing)
    callback drag-moved(length, length);
    callback drag-ended();
    property <bool> dragging;
    // 0 → 1 when the tab appears, back to 0 while it closes.
    property <bool> appeared;
    property <float> presence: root.closing ? 0 : root.appeared ? 1 : 0;
    animate presence { duration: 170ms; easing: ease-out; }
    init => { self.appeared = true; }
    height: 32px;
    // Shrinks like browser tabs when many are open.
    min-width: 64px * root.presence;
    preferred-width: 200px * root.presence;
    max-width: 220px * root.presence;
    horizontal-stretch: 1;
    opacity: root.presence;
    clip: true;

    area := TouchArea {
        enabled: !root.closing;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.dragging = false;
                root.activated();
            }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.dragging) {
                root.dragging = false;
                root.drag-ended();
            }
            // Middle click closes, like a browser.
            if (e.button == PointerEventButton.middle && e.kind == PointerEventKind.up) { root.closed(); }
        }
        moved => {
            if (self.pressed) {
                if (!root.dragging && abs(self.mouse-x - self.pressed-x) > 4px) { root.dragging = true; }
                if (root.dragging) { root.drag-moved(self.mouse-x - self.pressed-x, root.width + 4px); }
            }
        }
    }

    chip := Rectangle {
        x: root.shift;
        width: root.width;
        height: root.height;
        animate x { duration: root.being-dragged ? 0ms : 160ms; easing: ease-out; }
        border-radius: Theme.radius-m;
        background: root.active ? Theme.raised : area.has-hover ? Theme.hover : transparent;
        drop-shadow-blur: root.being-dragged ? 14px : root.active ? 6px : 0px;
        drop-shadow-offset-y: root.being-dragged ? 4px : 1px;
        drop-shadow-color: Theme.dark ? #00000060 : #0000001f;
        animate background, drop-shadow-blur { duration: 120ms; easing: ease-out; }
        row := HorizontalLayout {
            padding-left: 10px;
            padding-right: 4px;
            spacing: 8px;
            Icon {
                source: root.kind == 1 ? @image-url("icons/compose.svg") : root.kind == 2 ? @image-url("icons/settings.svg") : @image-url("icons/mail-open.svg");
                width: 14px;
                height: 14px;
                y: (parent.height - self.height) / 2;
                tint: root.active ? Theme.text-muted : Theme.text-faint;
            }
            Text {
                text: root.title;
                overflow: elide;
                horizontal-stretch: 1;
                font-size: Theme.font-s;
                font-weight: root.unseen ? 600 : 400;
                color: root.active || root.unseen ? Theme.text : Theme.text-muted;
                vertical-alignment: center;
            }
            close := Rectangle {
                width: 22px;
                height: 22px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-s;
                opacity: root.active || area.has-hover || close-area.has-hover ? 1 : 0;
                animate opacity { duration: 120ms; }
                background: close-area.has-hover ? Theme.pressed : transparent;
                close-area := TouchArea { enabled: !root.closing; clicked => { root.closed(); } }
                Icon { source: @image-url("icons/close.svg"); width: 12px; height: 12px; tint: Theme.text-faint; }
            }
        }
    }
}
