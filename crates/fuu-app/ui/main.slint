// Fuu main window: custom title bar, then sidebar / message list / reader.
// The reader body hosts either a host-composited page image (Blitz), a native
// child webview laid over `reader-host`, or the plain-text fallback.

import { ListView, TextEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    Divider, Icon, IconButton, PrimaryButton, SecondaryButton, Avatar, NavItem,
    SearchField, ComposeField, Dialog, MenuRow, CaptionButton,
} from "components.slint";

export struct MessageRow {
    sender: string,
    subject: string,
    preview: string,
    date: string,
    unread: bool,
    initials: string,
    avatar: int,
}

component MessageItem inherits Rectangle {
    in property <MessageRow> message;
    in property <bool> selected;
    callback clicked;
    height: 80px;
    Rectangle {
        x: 10px;
        y: 1px;
        width: parent.width - 20px;
        height: parent.height - 2px;
        border-radius: Theme.radius-l;
        background: root.selected ? Theme.selected : area.has-hover ? Theme.hover : transparent;
        animate background { duration: 80ms; }
        area := TouchArea { clicked => { root.clicked(); } }
        // Unread marker in the left gutter
        if root.message.unread: Rectangle {
            x: 7px;
            y: 19px;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: Theme.accent;
        }
        VerticalLayout {
            padding-left: 22px;
            padding-right: 16px;
            padding-top: 13px;
            padding-bottom: 12px;
            spacing: 3px;
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.message.sender;
                    overflow: elide;
                    horizontal-stretch: 1;
                    font-size: Theme.font-m;
                    font-weight: root.message.unread ? 600 : 400;
                    color: Theme.text;
                }
                Text {
                    text: root.message.date;
                    font-size: Theme.font-xs;
                    color: Theme.text-faint;
                    vertical-alignment: center;
                }
            }
            Text {
                text: root.message.subject;
                overflow: elide;
                font-size: Theme.font-m;
                font-weight: root.message.unread ? 500 : 400;
                color: root.message.unread ? Theme.text : Theme.text-muted;
            }
            Text {
                text: root.message.preview;
                overflow: elide;
                font-size: Theme.font-s;
                color: Theme.text-faint;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Fuu";
    preferred-width: 1240px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 540px;
    background: Theme.bg;
    default-font-size: 13px;

    // Platform chrome: macOS keeps its traffic lights over a transparent title bar;
    // elsewhere Fuu draws its own caption buttons.
    in property <bool> is-mac;
    in property <bool> maximised;

    in property <[MessageRow]> messages;
    in-out property <int> current-row: -1;
    in property <bool> has-message;
    in property <string> reader-subject;
    in property <string> reader-name;
    in property <string> reader-address;
    in property <string> reader-to: "自分";
    in property <string> reader-initials;
    in property <int> reader-avatar;
    in property <string> reader-date;
    in property <string> status-text;
    in-out property <string> feed-summary;
    in property <string> renderer-error;
    in property <bool> use-fallback;
    // Host-composited renderer (Blitz): the painted page and its logical size.
    in property <bool> use-page-image;
    in property <image> page-image;
    in property <length> page-width;
    in property <length> page-height;
    // Cursor index from fuu_render::Cursor (0 default, 1 text, 2 pointer, ...).
    in property <int> page-cursor;
    in property <bool> has-selection;
    in property <string> renderer-label: "Blitz";
    out property <bool> dark-mode: Theme.dark;
    in property <string> fallback-text;
    in property <string> link-url;
    in-out property <bool> link-dialog-open;
    in-out property <bool> info-dialog-open;
    in-out property <bool> composing;
    in-out property <string> compose-title: "新規メッセージ";
    in-out property <string> compose-to;
    in-out property <string> compose-subject;
    in-out property <string> compose-body;
    in-out property <string> search-text;
    in-out property <bool> searching;
    in property <string> mailbox: "受信トレイ";

    // Geometry of the reader body, in logical pixels relative to the window.
    out property <length> reader-x: reader-host.absolute-position.x;
    out property <length> reader-y: reader-host.absolute-position.y;
    out property <length> reader-w: reader-host.width;
    out property <length> reader-h: reader-host.height;
    // True whenever something drawn by Slint overlaps the reader body.
    out property <bool> reader-covered: link-dialog-open || info-dialog-open || composing || !has-message;

    callback row-selected(int);
    callback page-clicked(length, length);
    callback page-pointer-moved(length, length, bool);
    // phase: 0 = down, 2 = up
    callback page-pointer(int, length, length);
    callback copy-selection();
    callback select-all();
    callback clear-selection();
    callback page-pointer-left();
    callback toggle-renderer();
    callback load-security-sample();
    callback load-cjk-sample();
    callback link-confirmed();
    callback start-compose();
    callback send-compose();
    callback reply(bool);
    callback forward();
    callback archive();
    callback delete();
    // Window chrome
    callback drag-window();
    callback minimise-window();
    callback toggle-maximise();
    callback close-window();
    // Edge resize; direction: 0 N, 1 S, 2 E, 3 W, 4 NE, 5 NW, 6 SE, 7 SW
    callback resize-window(int);

    VerticalLayout {
        // ───────────── Title bar
        Rectangle {
            height: 48px;
            // Empty areas of the bar move the window (double-click maximises natively).
            TouchArea {
                pointer-event(e) => {
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                        root.drag-window();
                    }
                }
            }
            HorizontalLayout {
                padding-left: root.is-mac ? 84px : 14px;
                padding-right: root.is-mac ? 14px : 0px;
                spacing: 6px;

                // Mailbox and account switcher
                mailbox-button := Rectangle {
                    width: mailbox-row.preferred-width;
                    height: 32px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-m;
                    background: mailbox-area.has-hover ? Theme.hover : transparent;
                    mailbox-area := TouchArea { clicked => { mailbox-popup.show(); } }
                    mailbox-row := HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        Text { text: root.mailbox; font-size: Theme.font-l; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                        Icon { source: @image-url("icons/chevron-down.svg"); width: 13px; height: 13px; y: (parent.height - self.height) / 2; tint: Theme.text-faint; }
                    }
                }

                Rectangle { horizontal-stretch: 1; }
                if root.searching: SearchField {
                    width: 280px;
                    y: (parent.height - self.height) / 2;
                    text <=> root.search-text;
                    placeholder: "検索";
                }
                IconButton {
                    icon: root.searching ? @image-url("icons/close.svg") : @image-url("icons/search.svg");
                    y: (parent.height - self.height) / 2;
                    clicked => { root.searching = !root.searching; }
                }
                IconButton {
                    icon: @image-url("icons/compose.svg");
                    tint: Theme.text-muted;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.start-compose(); }
                }
                dev-button := IconButton {
                    icon: @image-url("icons/flask.svg");
                    y: (parent.height - self.height) / 2;
                    clicked => { dev-popup.show(); }
                }
                if !root.is-mac: Rectangle { width: 6px; }
                if !root.is-mac: CaptionButton { icon: @image-url("icons/win-minimise.svg"); clicked => { root.minimise-window(); } }
                if !root.is-mac: CaptionButton {
                    icon: root.maximised ? @image-url("icons/win-restore.svg") : @image-url("icons/win-maximise.svg");
                    clicked => { root.toggle-maximise(); }
                }
                if !root.is-mac: CaptionButton { icon: @image-url("icons/win-close.svg"); is-close: true; clicked => { root.close-window(); } }
            }
        }

        HorizontalLayout {
            // ───────────── Message list
            ListView {
                width: 380px;
                for row[i] in root.messages: MessageItem {
                    message: row;
                    selected: i == root.current-row;
                    clicked => {
                        root.current-row = i;
                        root.row-selected(i);
                    }
                }
            }
            Divider { width: 1px; }

            // ───────────── Reader: a centred column of readable width
            HorizontalLayout {
              Rectangle { horizontal-stretch: 1; min-width: 0px; }
              VerticalLayout {
                horizontal-stretch: 0;
                preferred-width: 760px;
                min-width: 320px;
                if root.has-message: VerticalLayout {
                    padding-left: 40px;
                    padding-right: 40px;
                    padding-top: 28px;
                    padding-bottom: 14px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 16px;
                        Text {
                            text: root.reader-subject;
                            font-size: Theme.font-xl;
                            font-weight: 600;
                            wrap: word-wrap;
                            color: Theme.text;
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: root.reader-name; font-size: Theme.font-m; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                        Text { text: root.reader-date; font-size: Theme.font-s; color: Theme.text-faint; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                        reply-button := Rectangle {
                            width: reply-row.preferred-width;
                            height: 30px;
                            border-radius: Theme.radius-m;
                            background: reply-area.has-hover ? Theme.hover : transparent;
                            reply-area := TouchArea { clicked => { root.reply(false); } }
                            reply-row := HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 10px;
                                spacing: 6px;
                                Icon { source: @image-url("icons/reply.svg"); width: 15px; height: 15px; y: (parent.height - self.height) / 2; tint: reply-area.has-hover ? Theme.text : Theme.text-muted; }
                                Text { text: "返信"; font-size: Theme.font-s; color: reply-area.has-hover ? Theme.text : Theme.text-muted; vertical-alignment: center; }
                            }
                        }
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            IconButton {
                                icon: @image-url("icons/more.svg");
                                clicked => { actions-popup.show(); }
                            }
                            actions-popup := PopupWindow {
                                x: parent.width - 200px;
                                y: parent.height + 4px;
                                width: 200px;
                                Rectangle {
                                    border-radius: Theme.radius-l;
                                    background: Theme.raised;
                                    drop-shadow-blur: 24px;
                                    drop-shadow-offset-y: 6px;
                                    drop-shadow-color: #00000026;
                                    border-width: 1px;
                                    border-color: Theme.hairline;
                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 1px;
                                        MenuRow { icon: @image-url("icons/reply-all.svg"); label: "全員に返信"; clicked => { root.reply(true); } }
                                        MenuRow { icon: @image-url("icons/forward.svg"); label: "転送"; clicked => { root.forward(); } }
                                        MenuRow { icon: @image-url("icons/archive.svg"); label: "アーカイブ"; clicked => { root.archive(); } }
                                        MenuRow { icon: @image-url("icons/trash.svg"); label: "削除"; clicked => { root.delete(); } }
                                    }
                                }
                            }
                        }
                    }
                }

                reader-host := Rectangle {
                    vertical-stretch: 1;
                    if root.use-page-image && root.has-message: page-focus := FocusScope {
                        // Visible-area y of the pointer while dragging (for auto-scroll).
                        property <length> drag-visible-y;
                        key-pressed(event) => {
                            if (event.modifiers.control || event.modifiers.meta) {
                                if (event.text == "c" || event.text == "C") { root.copy-selection(); return accept; }
                                if (event.text == "a" || event.text == "A") { root.select-all(); return accept; }
                            }
                            if (event.text == Key.Escape) { root.clear-selection(); return accept; }
                            return reject;
                        }
                        ContextMenuArea {
                            Menu {
                                MenuItem { title: "コピー"; enabled: root.has-selection; activated => { root.copy-selection(); } }
                                MenuItem { title: "すべて選択"; activated => { root.select-all(); } }
                            }
                            page-scroll := ScrollView {
                                width: parent.width;
                                height: parent.height;
                                content-width: root.page-width;
                                content-height: root.page-height;
                                Image {
                                    x: 0; y: 0;
                                    width: root.page-width;
                                    height: root.page-height;
                                    source: root.page-image;
                                    image-fit: fill;
                                }
                                page-touch := TouchArea {
                                    x: 0; y: 0;
                                    width: root.page-width;
                                    height: root.page-height;
                                    mouse-cursor:
                                        root.page-cursor == 1 ? MouseCursor.text :
                                        root.page-cursor == 2 ? MouseCursor.pointer :
                                        root.page-cursor == 3 ? MouseCursor.help :
                                        root.page-cursor == 4 ? MouseCursor.not-allowed :
                                        root.page-cursor == 5 ? MouseCursor.crosshair :
                                        root.page-cursor == 6 ? MouseCursor.move :
                                        root.page-cursor == 7 ? MouseCursor.wait :
                                        root.page-cursor == 8 ? MouseCursor.progress :
                                        root.page-cursor == 9 ? MouseCursor.grab :
                                        root.page-cursor == 10 ? MouseCursor.grabbing :
                                        MouseCursor.default;
                                    clicked => { root.page-clicked(self.pressed-x, self.pressed-y); }
                                    pointer-event(e) => {
                                        if (e.button == PointerEventButton.left) {
                                            if (e.kind == PointerEventKind.down) {
                                                page-focus.focus();
                                                page-focus.drag-visible-y = self.mouse-y + page-scroll.content-y;
                                                root.page-pointer(0, self.mouse-x, self.mouse-y);
                                            } else if (e.kind == PointerEventKind.up) {
                                                root.page-pointer(2, self.mouse-x, self.mouse-y);
                                            }
                                        }
                                    }
                                    // `moved` only fires while pressed; track hover via the mouse position.
                                    changed mouse-x => {
                                        page-focus.drag-visible-y = self.mouse-y + page-scroll.content-y;
                                        root.page-pointer-moved(self.mouse-x, self.mouse-y, self.pressed);
                                    }
                                    changed mouse-y => {
                                        page-focus.drag-visible-y = self.mouse-y + page-scroll.content-y;
                                        root.page-pointer-moved(self.mouse-x, self.mouse-y, self.pressed);
                                    }
                                    changed has-hover => { if (!self.has-hover) { root.page-pointer-left(); } }
                                }
                            }
                        }
                        // Auto-scroll while a selection drag is held near the top or bottom edge.
                        Timer {
                            interval: 16ms;
                            running: page-touch.pressed && (page-focus.drag-visible-y < 24px || page-focus.drag-visible-y > page-scroll.visible-height - 24px);
                            triggered => {
                                if (page-focus.drag-visible-y > page-scroll.visible-height - 24px) {
                                    page-scroll.content-y = max(min(0px, page-scroll.visible-height - root.page-height), page-scroll.content-y - 14px);
                                } else {
                                    page-scroll.content-y = min(0px, page-scroll.content-y + 14px);
                                }
                                root.page-pointer-moved(page-touch.mouse-x, page-focus.drag-visible-y - page-scroll.content-y, true);
                            }
                        }
                    }
                    if root.use-fallback && root.has-message: ScrollView {
                        VerticalLayout {
                            padding-left: 40px;
                            padding-right: 40px;
                            padding-top: 8px;
                            Text { text: root.fallback-text; wrap: word-wrap; color: Theme.text; }
                        }
                    }
                    // Empty state
                    if !root.has-message: VerticalLayout {
                        alignment: center;
                        spacing: 10px;
                        HorizontalLayout {
                            alignment: center;
                            Icon { source: @image-url("icons/mail-open.svg"); width: 26px; height: 26px; tint: Theme.text-faint.with-alpha(0.7); }
                        }
                        Text { text: "メールを選択してください"; font-size: Theme.font-m; color: Theme.text-faint; horizontal-alignment: center; }
                    }
                }
              }
              Rectangle { horizontal-stretch: 1; min-width: 0px; }
            }
        }
    }

    // ───────────── Popups
    mailbox-popup := PopupWindow {
        x: mailbox-button.absolute-position.x;
        y: 44px;
        width: 248px;
        Rectangle {
            border-radius: Theme.radius-l;
            background: Theme.raised;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000026;
            border-width: 1px;
            border-color: Theme.hairline;
            VerticalLayout {
                padding: 6px;
                spacing: 1px;
                MenuRow { icon: @image-url("icons/inbox.svg"); label: "受信トレイ"; trailing: "714"; }
                MenuRow { icon: @image-url("icons/send.svg"); label: "送信済み"; }
                MenuRow { icon: @image-url("icons/draft.svg"); label: "下書き"; trailing: "2"; }
                MenuRow { icon: @image-url("icons/archive.svg"); label: "アーカイブ"; }
                MenuRow { icon: @image-url("icons/trash.svg"); label: "ゴミ箱"; }
                Rectangle { height: 5px; }
                Divider { height: 1px; }
                Rectangle { height: 5px; }
                Rectangle {
                    height: 40px;
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 10px;
                        Avatar { initials: "F"; hue: 0; size: 22px; y: (parent.height - self.height) / 2; }
                        VerticalLayout {
                            alignment: center;
                            Text { text: "Fuu spike"; font-size: Theme.font-s; font-weight: 600; color: Theme.text; }
                            Text { text: "spike@fuu.invalid"; font-size: Theme.font-xs; color: Theme.text-faint; }
                        }
                    }
                }
                MenuRow { icon: @image-url("icons/plus.svg"); label: "アカウントを追加"; trailing: "M1"; }
            }
        }
    }

    dev-popup := PopupWindow {
        x: dev-button.absolute-position.x + dev-button.width - 280px;
        y: 46px;
        width: 280px;
        Rectangle {
            border-radius: Theme.radius-l;
            background: Theme.raised;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000026;
            border-width: 1px;
            border-color: Theme.hairline;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                HorizontalLayout {
                    padding-left: 10px;
                    Text { text: "開発用（M0 検査）"; font-size: Theme.font-xs; color: Theme.text-faint; height: 26px; vertical-alignment: center; }
                }
                MenuRow { icon: @image-url("icons/shield.svg"); label: "セキュリティ検査文書"; clicked => { root.load-security-sample(); } }
                MenuRow { icon: @image-url("icons/type.svg"); label: "CJK 表示サンプル"; clicked => { root.load-cjk-sample(); } }
                MenuRow { icon: @image-url("icons/overlap.svg"); label: "重なり検査"; clicked => { root.info-dialog-open = true; } }
                MenuRow { icon: @image-url("icons/layers.svg"); label: "描画エンジン"; trailing: root.renderer-label; clicked => { root.toggle-renderer(); } }
                Divider { height: 1px; }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 6px;
                    Text { text: root.status-text; wrap: word-wrap; font-size: Theme.font-xs; color: Theme.text-faint; }
                }
                Rectangle { height: 4px; }
            }
        }
    }

    // ───────────── Composer sheet
    if root.composing: Rectangle {
        background: Theme.scrim;
        TouchArea { }
        Rectangle {
            width: min(parent.width - 96px, 720px);
            height: min(parent.height - 96px, 600px);
            border-radius: Theme.radius-xl;
            background: Theme.raised;
            drop-shadow-blur: 40px;
            drop-shadow-offset-y: 14px;
            drop-shadow-color: #00000033;
            clip: true;
            VerticalLayout {
                Rectangle {
                    height: 52px;
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 12px;
                        Text { text: root.compose-title; font-size: Theme.font-l; font-weight: 600; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                        IconButton { icon: @image-url("icons/close.svg"); y: (parent.height - self.height) / 2; clicked => { root.composing = false; } }
                    }
                }
                ComposeField { label: "宛先"; placeholder: "name@example.com"; text <=> root.compose-to; }
                ComposeField { label: "件名"; placeholder: "件名"; text <=> root.compose-subject; }
                Rectangle {
                    vertical-stretch: 1;
                    TextEdit {
                        x: 16px;
                        y: 10px;
                        width: parent.width - 32px;
                        height: parent.height - 16px;
                        text <=> root.compose-body;
                        wrap: word-wrap;
                        font-size: 14px;
                    }
                }
                Rectangle {
                    height: 60px;
                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 16px;
                        spacing: 4px;
                        PrimaryButton {
                            text: "送信";
                            icon: @image-url("icons/send.svg");
                            has-icon: true;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.send-compose(); }
                        }
                        Rectangle { width: 6px; }
                        IconButton { icon: @image-url("icons/paperclip.svg"); y: (parent.height - self.height) / 2; }
                        Rectangle { horizontal-stretch: 1; }
                        IconButton { icon: @image-url("icons/trash.svg"); y: (parent.height - self.height) / 2; clicked => { root.composing = false; } }
                    }
                }
            }
        }
    }

    if root.link-dialog-open: Dialog {
        title: "外部リンクを開きますか？";
        body: "既定のブラウザで次の URL を開きます。";
        detail: root.link-url;
        confirm-label: "ブラウザで開く";
        confirmed => { root.link-dialog-open = false; root.link-confirmed(); }
        cancelled => { root.link-dialog-open = false; }
    }

    if root.info-dialog-open: Dialog {
        title: "重なり検査";
        body: "このダイアログは Slint が描画しています。Blitz では文書の上に重なり、WebView では表示中だけ WebView を隠します。";
        show-cancel: false;
        confirmed => { root.info-dialog-open = false; }
    }

    // ───────────── Frameless resize handles (not needed on macOS)
    if !root.is-mac && !root.maximised: Rectangle {
        property <length> edge: 5px;
        TouchArea { x: edge; y: 0; width: parent.width - 2 * edge; height: edge; mouse-cursor: n-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(0); } } }
        TouchArea { x: edge; y: parent.height - edge; width: parent.width - 2 * edge; height: edge; mouse-cursor: s-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(1); } } }
        TouchArea { x: parent.width - edge; y: edge; width: edge; height: parent.height - 2 * edge; mouse-cursor: e-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(2); } } }
        TouchArea { x: 0; y: edge; width: edge; height: parent.height - 2 * edge; mouse-cursor: w-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(3); } } }
        TouchArea { x: parent.width - edge; y: 0; width: edge; height: edge; mouse-cursor: ne-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(4); } } }
        TouchArea { x: 0; y: 0; width: edge; height: edge; mouse-cursor: nw-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(5); } } }
        TouchArea { x: parent.width - edge; y: parent.height - edge; width: edge; height: edge; mouse-cursor: se-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(6); } } }
        TouchArea { x: 0; y: parent.height - edge; width: edge; height: edge; mouse-cursor: sw-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(7); } } }
    }
}
