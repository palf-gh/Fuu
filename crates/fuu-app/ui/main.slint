// Fuu main window: custom title bar, then sidebar / message list / reader.
// The reader body hosts either a host-composited page image (Blitz), a native
// child webview laid over `reader-host`, or the plain-text fallback.

import { ListView, TextEdit, ScrollView, Palette } from "std-widgets.slint";
import { SettingsView } from "settings.slint";
import { AccountSetupView } from "setup.slint";
import { AccountItem, FolderItem } from "models.slint";
export { AccountItem, FolderItem }
import { Theme } from "theme.slint";
import { RichEditor, EditorRect } from "editor.slint";
import { Tooltip, Notice } from "components.slint";
export { Tooltip, Notice }
export { EditorRect }
import {
    Divider, Icon, IconButton, PrimaryButton, SecondaryButton, Avatar, NavItem,
    SearchField, ComposeField, Dialog, MenuRow, CaptionButton, Tab, TooltipLayer, NoticeLayer,
} from "components.slint";

export struct ConversationRow {
    sender: string,
    subject: string,
    date: string,
    sent: bool,
}

export struct MessageRow {
    sender: string,
    subject: string,
    preview: string,
    date: string,
    unread: bool,
    initials: string,
    avatar: int,
    // Date section (今日, 昨日, …); `header` on the first row of a run, and
    // `collapsed` when the user closed the section (row hidden, header kept).
    section: string,
    header: bool,
    collapsed: bool,
    // Position in `messages` (the full list), for rows shown via `list-rows`.
    index: int,
    attachment: bool,
    conversation-open: bool,
    conversation-loading: bool,
    conversation: [ConversationRow],
}

export struct AttachmentItem {
    name: string,
    size: string,
    executable: bool,
}

export struct TabItem {
    title: string,
    kind: int,   // 0 mail, 1 compose, 2 settings
    unseen: bool,
    closing: bool,
}

component FolderRow inherits Rectangle {
    in property <FolderItem> folder;
    in property <bool> current;
    callback clicked;
    height: 32px;
    border-radius: Theme.radius-s;
    background: root.current ? Theme.selected : area.has-hover && root.folder.selectable ? Theme.hover : transparent;
    area := TouchArea { enabled: root.folder.selectable; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Icon {
            source: root.folder.role == 0 ? @image-url("icons/inbox.svg")
            : root.folder.role == 1 ? @image-url("icons/draft.svg")
            : root.folder.role == 2 ? @image-url("icons/send.svg")
            : root.folder.role == 3 ? @image-url("icons/archive.svg")
            : root.folder.role == 4 ? @image-url("icons/shield.svg")
            : root.folder.role == 5 ? @image-url("icons/trash.svg")
            : @image-url("icons/draft.svg");
            width: 15px;
            height: 15px;
            y: (parent.height - self.height) / 2;
            tint: root.current ? Theme.text : Theme.text-faint;
        }
        Text {
            text: root.folder.display;
            color: root.folder.selectable ? Theme.text : Theme.text-faint;
            font-size: Theme.font-m;
            font-weight: root.current ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component MessageItem inherits Rectangle {
    in property <MessageRow> message;
    in property <bool> selected;
    callback clicked;
    callback open-in-background;
    callback toggle-section();
    callback toggle-conversation();
    callback conversation-selected(int);
    // Quick actions shown on hover: 0 delete, 1 archive, 2 restore.
    callback quick-action(int);
    // Role of the shown folder (0 inbox … 4 junk, 5 trash, 6 other).
    in property <int> folder-role;
    property <bool> restorable: root.folder-role == 4 || root.folder-role == 5;
    property <length> header-height: root.message.header ? 34px : 0px;
    height: root.header-height + (root.message.collapsed ? 0px : 80px + (root.message.conversation-open ? (root.message.conversation.length > 0 ? root.message.conversation.length * 60px : 30px) : 0px));
    clip: true;
    if root.message.header: Rectangle {
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: root.header-height;
        border-radius: Theme.radius-m;
        background: section-area.has-hover ? Theme.hover : transparent;
        section-area := TouchArea { clicked => { root.toggle-section(); } }
        Icon {
            source: @image-url("icons/chevron-down.svg");
            x: 10px;
            y: (parent.height - self.height) / 2;
            width: 13px;
            height: 13px;
            transform-rotation: root.message.collapsed ? -90deg : 0deg;
            animate transform-rotation { duration: 120ms; easing: ease-out; }
            tint: Theme.text-faint;
        }
        Text {
            x: 32px;
            height: parent.height;
            text: root.message.section;
            font-size: Theme.font-s;
            font-weight: 600;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.border;
        }
    }
    if !root.message.collapsed: Rectangle {
        x: 10px;
        y: root.header-height + 1px;
        width: parent.width - 20px;
        height: 78px;
        border-radius: Theme.radius-l;
        background: root.selected ? Theme.selected : area.has-hover ? Theme.hover : transparent;
        animate background { duration: 80ms; }
        // Unread marker in the left gutter
        Rectangle {
            opacity: root.message.unread ? 1 : 0;
            animate opacity { duration: 220ms; easing: ease-out; }
            x: 7px;
            y: 19px;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: Theme.accent;
        }
        VerticalLayout {
            padding-left: 32px;
            padding-right: 16px;
            padding-top: 13px;
            padding-bottom: 12px;
            spacing: 3px;
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.message.sender;
                    overflow: elide;
                    horizontal-stretch: 1;
                    font-size: Theme.font-m;
                    font-weight: root.message.unread ? 600 : 400;
                    color: Theme.text;
                }
                if root.message.attachment: Icon {
                    source: @image-url("icons/paperclip.svg");
                    width: 13px;
                    height: 13px;
                    y: (parent.height - self.height) / 2;
                    tint: Theme.text-faint;
                    opacity: area.has-hover ? 0 : 1;
                }
                Text {
                    text: root.message.date;
                    font-size: Theme.font-xs;
                    color: Theme.text-faint;
                    vertical-alignment: center;
                    opacity: area.has-hover ? 0 : 1;
                }
            }
            Text {
                text: root.message.subject;
                overflow: elide;
                font-size: Theme.font-m;
                font-weight: root.message.unread ? 500 : 400;
                color: root.message.unread ? Theme.text : Theme.text-muted;
            }
            Text {
                text: root.message.preview;
                overflow: elide;
                font-size: Theme.font-s;
                color: Theme.text-faint;
            }
        }
        // Last, so it sits above the text; the hover actions are its children so
        // hovering them keeps the row hovered.
        area := TouchArea {
            clicked => { root.clicked(); }
            pointer-event(e) => {
                if (e.button == PointerEventButton.middle && e.kind == PointerEventKind.up) { root.open-in-background(); }
            }
            if area.has-hover: Rectangle {
                x: parent.width - self.width - 8px;
                y: 6px;
                width: actions.preferred-width;
                height: 28px;
                border-radius: Theme.radius-m;
                background: root.selected ? Theme.selected : Theme.hover;
                actions := HorizontalLayout {
                    spacing: 2px;
                    if root.restorable: IconButton {
                        icon: @image-url("icons/inbox.svg"); size: 28px; icon-size: 15px; tint: Theme.text-muted;
                        tooltip: @tr("Move to Inbox");
                        clicked => { root.quick-action(2); }
                    }
                    if !root.restorable && root.folder-role != 3: IconButton {
                        icon: @image-url("icons/archive.svg"); size: 28px; icon-size: 15px; tint: Theme.text-muted;
                        tooltip: @tr("Archive");
                        clicked => { root.quick-action(1); }
                    }
                    if root.folder-role != 5: IconButton {
                        icon: @image-url("icons/trash.svg"); size: 28px; icon-size: 15px; tint: Theme.text-muted;
                        tooltip: @tr("Delete");
                        clicked => { root.quick-action(0); }
                    }
                }
            }
        }
        Rectangle {
            x: 4px; y: 28px; width: 24px; height: 24px;
            background: conversation-toggle.has-hover ? Theme.hover : transparent;
            border-radius: Theme.radius-s;
            Icon {
                x: 5px; y: 5px; width: 14px; height: 14px;
                source: @image-url("icons/chevron-down.svg");
                transform-rotation: root.message.conversation-open ? 0deg : -90deg;
                tint: Theme.text-faint;
            }
            conversation-toggle := TouchArea { clicked => { root.toggle-conversation(); } }
        }
    }
    if !root.message.collapsed && root.message.conversation-open: VerticalLayout {
        x: 32px; y: root.header-height + 80px; width: parent.width - 42px;
        spacing: 0px;
        if root.message.conversation.length == 0: Text {
            height: 30px; text: root.message.conversation-loading ? "…" : "—";
            color: Theme.text-faint; font-size: Theme.font-m;
        }
        for child[i] in root.message.conversation: Rectangle {
            height: 60px;
            border-radius: Theme.radius-s;
            background: child-area.has-hover ? Theme.hover : transparent;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px; spacing: 8px;
                if child.sent: Icon { source: @image-url("icons/send.svg"); width: 14px; height: 14px; tint: Theme.text-faint; }
                VerticalLayout {
                    alignment: center; spacing: 3px;
                    Text { text: child.sender; font-size: Theme.font-m; color: Theme.text; overflow: elide; }
                    Text { text: child.subject; font-size: Theme.font-s; color: Theme.text-muted; overflow: elide; }
                }
                Text { text: child.date; font-size: Theme.font-xs; color: Theme.text-faint; vertical-alignment: center; }
            }
            child-area := TouchArea { clicked => { root.conversation-selected(i); } }
        }
    }
}

export component AppWindow inherits Window {
    title: "Fuu";
    in property <string> ui-font-family;
    default-font-family: root.ui-font-family;
    // No `icon` here: Windows loads it from the exe resource (see
    // select_backend) so the taskbar gets a properly sized image; macOS takes
    // the bundle's icon.
    preferred-width: 1240px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 540px;
    background: Theme.bg;
    default-font-size: 13px;

    // Platform chrome: macOS keeps its traffic lights over a transparent title bar;
    // elsewhere Fuu draws its own caption buttons.
    in property <bool> is-mac;
    // Linux: GNOME-style round caption buttons.
    in property <bool> is-linux;
    in property <bool> maximised;
    // Windows caption-glyph font ("" when absent: SVG icons are used).
    in property <string> caption-font;
    // Slint applies decorations from `no-frame` (overriding the winit hook), so the
    // frameless state must be declared here too. macOS keeps its native frame.
    no-frame: !root.is-mac;

    in property <[MessageRow]> messages;
    // What the list view shows: `messages` without the rows of closed sections
    // (their headers stay). Hidden rows must not reach the ListView at all.
    in property <[MessageRow]> list-rows;
    in-out property <int> current-row: -1;
    // Open or close a date section of the list; the next visible row from a
    // row in a direction (±1), skipping closed sections.
    callback toggle-section(string);
    callback toggle-conversation(int);
    callback conversation-selected(int, int);
    // A hover action on a list row (index into `messages`; 0 delete,
    // 1 archive, 2 restore to the inbox).
    callback row-action(int, int);
    // Role of the shown folder, as FolderItem.role.
    in property <int> folder-role;
    callback restore();
    pure callback step-row(int, int) -> int;
    in property <bool> has-message;
    // The reader shows an attachment preview (no reply / archive / delete).
    in property <bool> viewing-attachment;
    in property <string> reader-subject;
    in property <string> reader-name;
    in property <string> reader-address;
    in property <string> reader-to;
    in property <string> reader-cc;
    in property <[AttachmentItem]> attachments;
    in property <bool> remote-blocked;
    in property <bool> remote-allowable;
    in property <bool> remote-loading;
    in-out property <string> exec-warning;
    in property <string> reader-initials;
    in property <int> reader-avatar;
    in property <string> reader-date;
    in property <string> status-text;
    in-out property <string> feed-summary;
    in property <string> renderer-error;
    in property <bool> use-fallback;
    // Host-composited renderer (Blitz): the painted page and its logical size.
    in property <bool> use-page-image;
    in property <image> page-image;
    in property <length> page-width;
    in property <length> page-height;
    // Cursor index from fuu_render::Cursor (0 default, 1 text, 2 pointer, ...).
    in property <int> page-cursor;
    in property <bool> has-selection;
    out property <bool> dark-mode: Theme.dark;
    in property <string> fallback-text;
    in property <string> link-url;
    in-out property <bool> link-dialog-open;
    in-out property <bool> info-dialog-open;
    in-out property <bool> composing;
    in-out property <string> compose-title: @tr("New message");
    in-out property <string> compose-to;
    in-out property <string> compose-subject;
    // Rich editor (state driven by src/editor.rs)
    in-out property <string> editor-text;
    in property <image> editor-page;
    in property <length> editor-page-height;
    in property <length> editor-caret-x;
    in property <length> editor-caret-y;
    in property <length> editor-caret-h: 22px;
    in property <[EditorRect]> editor-selection;
    in property <bool> editor-bold;
    in property <bool> editor-italic;
    in property <bool> editor-underline;
    in property <bool> editor-strike;
    in property <int> editor-block;
    in property <int> editor-sel-serial;
    in property <int> editor-sel-anchor;
    in property <int> editor-sel-cursor;
    in property <int> editor-focus-serial;
    callback editor-edited(string);
    callback editor-command(string);
    callback editor-navigate(string, bool);
    callback editor-enter() -> bool;
    callback editor-pointer(int, length, length, int, bool);
    callback editor-caret-moved(int, int);
    callback editor-preedit-changed(string);
    callback editor-resized(length);
    callback editor-focus-gained();
    in-out property <string> search-text;
    in-out property <bool> searching;
    in-out property <string> compose-from;
    in-out property <string> compose-cc;
    in-out property <string> compose-bcc;
    in-out property <bool> compose-show-cc-bcc;
    in property <[AttachmentItem]> compose-attachments;
    in property <string> compose-error;
    in property <bool> compose-sending;
    in property <bool> settings-open;
    in-out property <int> settings-page;
    // Settings → 署名: the chosen account's signature (src/mail.rs loads and saves it).
    in-out property <string> signature-text;
    in-out property <bool> signature-enabled: true;
    in property <[string]> signature-accounts;
    in-out property <int> signature-account: -1;
    callback signature-edited();
    callback signature-account-picked();
    changed signature-text => { self.signature-edited(); }
    changed signature-enabled => { self.signature-edited(); }
    changed signature-account => { self.signature-account-picked(); }
    in-out property <bool> compose-html: true;
    // Updates (src/update.rs). state: 0 none, 1 available, 2 downloading,
    // 3 installed (restart), 4 checking.
    in property <int> update-state;
    in property <string> update-version;
    in property <float> update-progress;
    in property <string> update-status;
    in-out property <bool> check-updates: true;
    in property <string> app-version;
    callback update-install();
    callback update-restart();
    callback check-update-now();
    // Theme, HTML sending or the update check changed: save preferences.
    callback prefs-changed();
    changed compose-html => { self.prefs-changed(); }
    changed check-updates => { self.prefs-changed(); }
    // UI language: 0 follows the system, then fuu_i18n::LANGUAGES in order.
    in property <[string]> language-names;
    in-out property <int> language-index;
    changed language-index => { self.prefs-changed(); }
    // Default mail app (settings → 一般); refreshed when settings open.
    in property <string> default-mail-status;
    in property <bool> is-default-mail-app;
    callback make-default-mail-app();
    callback refresh-default-mail();
    callback settings-closed();
    changed settings-open => { if (self.settings-open) { self.refresh-default-mail(); } else { self.settings-closed(); } }
    // 0 system, 1 light, 2 dark
    in-out property <int> theme-mode;
    property <ColorScheme> system-scheme;
    // Bumped by Rust whenever the right pane changes, to play the reveal.
    in property <int> pane-version;
    property <bool> pane-fresh;
    changed pane-version => { self.pane-fresh = true; }
    changed theme-mode => {
        Palette.color-scheme = self.theme-mode == 1 ? ColorScheme.light : self.theme-mode == 2 ? ColorScheme.dark : self.system-scheme;
        self.prefs-changed();
    }
    in property <string> mailbox: @tr("Inbox");
    in property <string> account-name: @tr("No account");
    in property <string> account-email;
    in property <string> account-initial: "+";
    in property <[AccountItem]> accounts;
    in property <int> active-account: -1;
    in property <[FolderItem]> folders;
    in property <string> current-folder;
    // Shown in the list when there are no rows (loading, error, empty folder).
    in property <string> list-message;
    in property <bool> list-busy;
    // The list could not be loaded (list-message holds the reason).
    in property <bool> list-failed;
    callback retry-load();
    // OAuth sign-in renewal (banner above the message list)
    in property <string> reauth-email;
    in property <string> reauth-error;
    in property <bool> reauth-busy;
    in property <bool> active-oauth;
    callback reauth();
    callback reauth-cancel();
    // Account setup tab
    in property <bool> setup-open;
    in-out property <string> setup-name;
    in property <bool> setup-editing;
    in property <bool> setup-email-locked;
    callback edit-account(string);
    in-out property <string> setup-email;
    in-out property <string> setup-password;
    in-out property <string> setup-username;
    in-out property <string> setup-imap-host;
    in-out property <string> setup-imap-port: "993";
    in-out property <int> setup-imap-security;
    in-out property <string> setup-smtp-host;
    in-out property <string> setup-smtp-port: "465";
    in-out property <int> setup-smtp-security;
    in-out property <bool> setup-advanced;
    in property <string> setup-provider;
    in property <string> setup-note;
    in property <string> setup-error;
    in property <bool> setup-busy;
in property <string> setup-oauth-provider;
in property <bool> setup-password-login: true;
in property <bool> setup-oauth-waiting;
    in property <int> account-hue: 0;
    in property <[TabItem]> tabs;
    in property <int> active-tab: -1;

    // Geometry of the reader body, in logical pixels relative to the window.
    out property <length> reader-x: reader-host.absolute-position.x;
    out property <length> reader-y: reader-host.absolute-position.y;
    out property <length> reader-w: reader-host.width;
    out property <length> reader-h: reader-host.height;
    // True whenever something drawn by Slint overlaps the reader body.
    out property <bool> reader-covered: link-dialog-open || info-dialog-open || composing || settings-open || setup-open || !has-message;

    callback row-selected(int);
    callback page-clicked(length, length);
    callback page-pointer-moved(length, length, bool);
    // phase: 0 = down, 2 = up
    callback page-pointer(int, length, length);
    callback copy-selection();
    callback select-all();
    callback clear-selection();
    callback page-pointer-left();
    callback load-security-sample();
    callback load-cjk-sample();
    callback link-confirmed();
    callback start-compose();
    callback send-compose();
    callback reply(bool);
    callback forward();
    callback archive();
    callback delete();
    // Window chrome
    callback drag-window();
    callback minimise-window();
    callback toggle-maximise();
    callback close-window();
    // Edge resize; direction: 0 N, 1 S, 2 E, 3 W, 4 NE, 5 NW, 6 SE, 7 SW
    callback resize-window(int);
    callback tab-activated(int);
    callback tab-moved(int, int);
    callback row-open-in-tab(int);
    // Tab shortcuts
    callback new-tab();
    callback close-active-tab();
    callback reopen-closed-tab();
    callback cycle-tab(int);
    callback select-tab(int);
    callback tab-closed(int);
    callback discard-compose();
    callback compose-to-address(string);
    callback open-settings();
    // Opens the menus programmatically (snapshot checks).
    callback open-account-setup();
    // Rust closes the setup tab once the account has been added.
    callback setup-finished();
    callback body-ready();
    callback preview-ready();
    callback message-moved(string, string, int);
    callback save-attachment(int, bool);
    // Preview when possible, otherwise save.
    callback open-attachment(int, bool);
    callback allow-remote();
    callback compose-add-attachment();
    callback compose-remove-attachment(int);
    callback draft-sent(int);
    callback draft-failed(int, string);
    callback setup-email-edited(string);
    callback setup-submit();
callback setup-oauth-submit();
callback setup-oauth-cancel();
    callback select-account(int);
    callback select-folder(string);
    callback remove-account(string);
    callback show-account-menu();
    show-account-menu => { account-popup.show(); }
    callback show-mailbox-menu();
    show-mailbox-menu => { mailbox-popup.show(); }

    shortcuts := FocusScope {
      init => {
        root.system-scheme = Palette.color-scheme;
        self.focus();
      }
      // Keys bubble up here when the focused element does not use them.
      key-pressed(e) => {
        if (root.is-mac ? e.modifiers.meta : e.modifiers.control) {
            if (e.text == "t" || e.text == "T") {
                if (e.modifiers.shift) { root.reopen-closed-tab(); } else { root.new-tab(); }
                return accept;
            }
            if (e.text == "w" || e.text == "W") { root.close-active-tab(); return accept; }
            if (e.text == "n" || e.text == "N") { root.new-tab(); return accept; }
            if (e.text == ",") { root.open-settings(); return accept; }
            if (e.text == "9") { root.select-tab(-1); return accept; }
            if (e.text >= "1" && e.text <= "8" && e.text.character-count == 1) { root.select-tab(e.text.to-float() - 1); return accept; }
            if (root.is-mac && e.modifiers.shift && (e.text == "]" || e.text == "}")) { root.cycle-tab(1); return accept; }
            if (root.is-mac && e.modifiers.shift && (e.text == "[" || e.text == "{")) { root.cycle-tab(-1); return accept; }
        }
        if ((e.modifiers.control || e.modifiers.meta) && e.text == Key.Return && root.composing) {
            if (!root.compose-sending) { root.send-compose(); }
            return accept;
        }
        // Single keys (only reached when no text field has focus).
        if (!e.modifiers.control && !e.modifiers.meta && !e.modifiers.alt && !root.composing
            && !root.settings-open && !root.setup-open && !root.link-dialog-open && !root.info-dialog-open) {
            if (e.text == "j" || (e.text == Key.DownArrow && root.current-row >= 0)) {
                if (root.step-row(root.current-row, 1) != root.current-row) {
                    root.current-row = root.step-row(root.current-row, 1);
                    root.row-selected(root.current-row);
                }
                return accept;
            }
            if (e.text == "k" || (e.text == Key.UpArrow && root.current-row >= 0)) {
                if (root.current-row > 0 && root.step-row(root.current-row, -1) != root.current-row) {
                    root.current-row = root.step-row(root.current-row, -1);
                    root.row-selected(root.current-row);
                }
                return accept;
            }
            if (e.text == "c") { root.start-compose(); return accept; }
            if (e.text == Key.F5) { root.select-folder(root.current-folder); return accept; }
            if (root.has-message && !root.viewing-attachment) {
                if (e.text == "r") { root.reply(false); return accept; }
                if (e.text == "a" || e.text == "R") { root.reply(true); return accept; }
                if (e.text == "f") { root.forward(); return accept; }
                if (e.text == "e") {
                    if (root.folder-role == 4 || root.folder-role == 5) { root.restore(); } else if (root.folder-role != 3) { root.archive(); }
                    return accept;
                }
                if (e.text == "#" || e.text == Key.Delete) {
                    if (root.folder-role != 5) { root.delete(); }
                    return accept;
                }
            }
        }
        if (e.modifiers.control) {
            if (e.text == Key.Tab) { root.cycle-tab(e.modifiers.shift ? -1 : 1); return accept; }
            if (e.text == Key.Backtab) { root.cycle-tab(-1); return accept; }
            if (e.text == Key.PageDown) { root.cycle-tab(1); return accept; }
            if (e.text == Key.PageUp) { root.cycle-tab(-1); return accept; }
        }
        return reject;
      }
    VerticalLayout {
        // ───────────── Title bar (52px on macOS: the unified toolbar height,
        // so the native traffic lights sit level with this row)
        Rectangle {
            height: root.is-mac ? 52px : 48px;
            // Empty areas of the bar move the window (double-click maximises natively).
            TouchArea {
                pointer-event(e) => {
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                        root.drag-window();
                    }
                }
            }
            HorizontalLayout {
                padding-right: root.is-mac ? 14px : 0px;
                spacing: 6px;

                // Left block, as wide as the message list: the current account.
                HorizontalLayout {
                    padding-left: root.is-mac ? 92px : 12px;
                    account-button := Rectangle {
                        width: account-row.preferred-width;
                        height: 32px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.radius-m;
                        background: account-area.has-hover ? Theme.hover : transparent;
                        account-area := TouchArea { clicked => { account-popup.show(); } }
                        account-row := HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 8px;
                            spacing: 8px;
                            Avatar { initials: root.account-initial; hue: root.account-hue; size: 22px; y: (parent.height - self.height) / 2; }
                            VerticalLayout {
                                alignment: center;
                                Text { text: root.account-name; font-size: Theme.font-s; font-weight: 600; color: Theme.text; }
                                Text { text: root.account-email; font-size: Theme.font-xs; color: Theme.text-faint; }
                            }
                            Icon { source: @image-url("icons/chevron-down.svg"); width: 13px; height: 13px; y: (parent.height - self.height) / 2; tint: Theme.text-faint; }
                        }
                    }
                }

                // Tab strip: each tab is a place (mailbox, open message, draft).
                tab-strip := HorizontalLayout {
                    // Drag-to-reorder state
                    property <int> drag-index: -1;
                    property <length> drag-offset;
                    property <length> drag-slot: 1px;
                    property <int> drag-target: self.drag-index < 0 ? -1
                        : max(0, min(root.tabs.length - 1, self.drag-index + round(self.drag-offset / self.drag-slot)));
                    spacing: 0px;
                    padding-left: 8px;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    for tab[i] in root.tabs: Tab {
                        y: (parent.height - self.height) / 2;
                        title: tab.title;
                        kind: tab.kind;
                        active: i == root.active-tab;
                        unseen: tab.unseen;
                        closing: tab.closing;
                        being-dragged: i == tab-strip.drag-index;
                        shift: i == tab-strip.drag-index ? tab-strip.drag-offset
                            : tab-strip.drag-index < 0 ? 0px
                            : (tab-strip.drag-index < tab-strip.drag-target && i > tab-strip.drag-index && i <= tab-strip.drag-target) ? -tab-strip.drag-slot
                            : (tab-strip.drag-target < tab-strip.drag-index && i >= tab-strip.drag-target && i < tab-strip.drag-index) ? tab-strip.drag-slot
                            : 0px;
                        activated => { root.tab-activated(i); }
                        closed => { root.tab-closed(i); }
                        drag-moved(offset, slot) => {
                            tab-strip.drag-index = i;
                            tab-strip.drag-offset = offset;
                            tab-strip.drag-slot = slot;
                        }
                        drag-ended => {
                            if (tab-strip.drag-target != tab-strip.drag-index) {
                                root.tab-moved(tab-strip.drag-index, tab-strip.drag-target);
                            }
                            tab-strip.drag-index = -1;
                            tab-strip.drag-offset = 0px;
                        }
                    }
                    // Free space after the tabs stays draggable.
                    Rectangle { horizontal-stretch: 100; min-width: 24px; }
                }
                SearchField {
                    width: root.searching ? 260px : 0px;
                    opacity: root.searching ? 1 : 0;
                    visible: self.width > 1px;
                    animate width, opacity { duration: 180ms; easing: ease-out; }
                    y: (parent.height - self.height) / 2;
                    text <=> root.search-text;
                    placeholder: @tr("Search");
                }
                IconButton {
                    icon: root.searching ? @image-url("icons/close.svg") : @image-url("icons/search.svg");
                    y: (parent.height - self.height) / 2;
                    clicked => { root.searching = !root.searching; }
                }
                IconButton {
                    icon: @image-url("icons/compose.svg");
                    tint: Theme.text-muted;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.start-compose(); }
                }
                IconButton {
                    icon: @image-url("icons/settings.svg");
                    y: (parent.height - self.height) / 2;
                    clicked => { root.open-settings(); }
                }
                // A new version: install it (or restart into it).
                if root.update-state == 1 || root.update-state == 2 || root.update-state == 3: Rectangle {
                    width: update-label.preferred-width + 24px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 14px;
                    background: update-area.pressed ? Theme.accent.darker(0.15) : update-area.has-hover ? Theme.accent.darker(0.08) : Theme.accent;
                    update-area := TouchArea {
                        clicked => {
                            if (root.update-state == 1) { root.update-install(); }
                            else if (root.update-state == 3) { root.update-restart(); }
                        }
                    }
                    update-label := Text {
                        text: root.update-state == 1 ? @tr("Update {}", root.update-version)
                            : root.update-state == 2 ? @tr("Updating {}%", round(root.update-progress * 100))
                            : @tr("Restart to update");
                        color: #ffffff;
                        font-size: Theme.font-s;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if !root.is-mac: Rectangle { width: 6px; }
                if !root.is-mac: CaptionButton {
                    glyph: "\u{E921}";
                    glyph-font: root.caption-font;
                    round: root.is-linux;
                    icon: root.is-linux ? @image-url("icons/gnome-minimise.svg") : @image-url("icons/win-minimise.svg");
                    clicked => { root.minimise-window(); }
                }
                if !root.is-mac: CaptionButton {
                    glyph: root.maximised ? "\u{E923}" : "\u{E922}";
                    glyph-font: root.caption-font;
                    round: root.is-linux;
                    icon: root.is-linux ? (root.maximised ? @image-url("icons/gnome-restore.svg") : @image-url("icons/gnome-maximise.svg"))
                        : root.maximised ? @image-url("icons/win-restore.svg") : @image-url("icons/win-maximise.svg");
                    clicked => { root.toggle-maximise(); }
                }
                if !root.is-mac: CaptionButton {
                    glyph: "\u{E8BB}";
                    glyph-font: root.caption-font;
                    round: root.is-linux;
                    icon: root.is-linux ? @image-url("icons/gnome-close.svg") : @image-url("icons/win-close.svg");
                    is-close: true;
                    clicked => { root.close-window(); }
                }
                if root.is-linux: Rectangle { width: 8px; }
            }
        }

        HorizontalLayout {
            // ───────────── Message list
            VerticalLayout {
              width: 380px;
              HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 2px;
                padding-bottom: 8px;
                mailbox-button := Rectangle {
                    width: mailbox-row.preferred-width;
                    height: 30px;
                    border-radius: Theme.radius-m;
                    background: mailbox-area.has-hover ? Theme.hover : transparent;
                    mailbox-area := TouchArea { clicked => { mailbox-popup.show(); } }
                    mailbox-row := HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        Text { text: root.mailbox; font-size: Theme.font-l; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                        Text { text: root.messages.length; font-size: Theme.font-s; color: Theme.text-faint; vertical-alignment: center; }
                        Icon { source: @image-url("icons/chevron-down.svg"); width: 13px; height: 13px; y: (parent.height - self.height) / 2; tint: Theme.text-faint; }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
              }
              if root.reauth-email != "": Rectangle {
                height: reauth-col.preferred-height + 12px;
                Rectangle {
                    x: 16px;
                    y: 0px;
                    width: parent.width - 32px;
                    height: parent.height - 12px;
                    border-radius: Theme.radius-l;
                    background: Theme.field;
                    border-width: 1px;
                    border-color: Theme.hairline;
                    reauth-col := VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        Text {
                            text: root.reauth-busy ? @tr("Continue signing in in your browser") : @tr("You need to sign in again");
                            font-size: Theme.font-m;
                            font-weight: 600;
                            color: Theme.text;
                        }
                        Text {
                            text: root.reauth-email + (root.reauth-error != "" && !root.reauth-busy ? "\n" + root.reauth-error : "");
                            font-size: Theme.font-s;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            if !root.reauth-busy: PrimaryButton { text: @tr("Sign in"); clicked => { root.reauth(); } }
                            if root.reauth-busy: SecondaryButton { text: @tr("Cancel"); clicked => { root.reauth-cancel(); } }
                        }
                    }
                }
              }
              if root.messages.length == 0: VerticalLayout {
                alignment: center;
                spacing: 14px;
                padding-bottom: 80px;
                Text {
                    text: root.list-message;
                    font-size: Theme.font-m;
                    color: Theme.text-faint;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if root.accounts.length == 0: HorizontalLayout {
                    alignment: center;
                    PrimaryButton { text: @tr("Add account"); clicked => { root.open-account-setup(); } }
                }
                if root.list-failed && root.accounts.length > 0: HorizontalLayout {
                    alignment: center;
                    SecondaryButton { text: @tr("Reload"); clicked => { root.retry-load(); } }
                }
              }
              if root.messages.length > 0: ListView {
                for row in root.list-rows: MessageItem {
                    message: row;
                    selected: row.index == root.current-row;
                    clicked => {
                        root.current-row = row.index;
                        root.row-selected(row.index);
                    }
                    open-in-background => { root.row-open-in-tab(row.index); }
                    toggle-section => { root.toggle-section(row.section); }
                    toggle-conversation => { root.toggle-conversation(row.index); }
                    conversation-selected(i) => { root.conversation-selected(row.index, i); }
                    folder-role: root.folder-role;
                    quick-action(action) => { root.row-action(row.index, action); }
                }
              }
            }
            Divider { width: 1px; }

            // ───────────── Reader: a centred column of readable width
            Rectangle {
            HorizontalLayout {
              Rectangle { horizontal-stretch: 1; min-width: 0px; }
              pane := Rectangle {
                horizontal-stretch: 0;
                preferred-width: 760px;
                min-width: 320px;
                states [
                    fresh when root.pane-fresh: {
                        pane-body.opacity: 0;
                        pane-body.y: 8px;
                        out {
                            animate pane-body.opacity, pane-body.y { duration: 220ms; easing: ease-out; }
                        }
                    }
                ]
              pane-body := VerticalLayout {
                y: 0px;
                width: parent.width;
                height: parent.height;
                if root.has-message && !root.composing: VerticalLayout {
                    padding-left: 40px;
                    padding-right: 40px;
                    padding-top: 28px;
                    padding-bottom: 14px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 16px;
                        Text {
                            text: root.reader-subject;
                            font-size: Theme.font-xl;
                            font-weight: 600;
                            wrap: word-wrap;
                            color: Theme.text;
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        // The sender: click to write to them.
                        sender-name := Text {
                            text: root.reader-name;
                            font-size: Theme.font-m;
                            font-weight: 600;
                            color: sender-area.has-hover && root.reader-address != "" ? Theme.accent : Theme.text;
                            vertical-alignment: center;
                            sender-area := TouchArea {
                                enabled: root.reader-address != "" && !root.viewing-attachment;
                                mouse-cursor: pointer;
                                clicked => { root.compose-to-address(root.reader-address); }
                            }
                        }
                        Text { text: root.reader-date; font-size: Theme.font-s; color: Theme.text-faint; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                        if root.viewing-attachment: HorizontalLayout {
                            SecondaryButton { text: @tr("Save"); clicked => { root.save-attachment(0, false); } }
                        }
                        if !root.viewing-attachment: HorizontalLayout {
                            spacing: 2px;
                            IconButton { icon: @image-url("icons/reply.svg"); icon-size: 16px; tint: Theme.text-muted; tooltip: @tr("Reply (R)"); clicked => { root.reply(false); } }
                            IconButton { icon: @image-url("icons/reply-all.svg"); icon-size: 16px; tint: Theme.text-muted; tooltip: @tr("Reply all (A)"); clicked => { root.reply(true); } }
                            IconButton { icon: @image-url("icons/forward.svg"); icon-size: 16px; tint: Theme.text-muted; tooltip: @tr("Forward (F)"); clicked => { root.forward(); } }
                            Rectangle { width: 8px; }
                            if root.folder-role == 4 || root.folder-role == 5: IconButton { icon: @image-url("icons/inbox.svg"); icon-size: 16px; tint: Theme.text-muted; tooltip: @tr("Move to Inbox (E)"); clicked => { root.restore(); } }
                            if root.folder-role != 4 && root.folder-role != 5 && root.folder-role != 3: IconButton { icon: @image-url("icons/archive.svg"); icon-size: 16px; tint: Theme.text-muted; tooltip: @tr("Archive (E)"); clicked => { root.archive(); } }
                            if root.folder-role != 5: IconButton { icon: @image-url("icons/trash.svg"); icon-size: 16px; tint: Theme.text-muted; tooltip: @tr("Delete (Delete)"); clicked => { root.delete(); } }
                        }
                    }
                }

                if root.has-message && !root.composing && (root.reader-to != "" || root.attachments.length > 0 || root.remote-blocked): VerticalLayout {
                    padding-left: 40px;
                    padding-right: 40px;
                    padding-bottom: 12px;
                    spacing: 8px;
                    if root.reader-to != "": Text {
                        text: (root.reader-cc != "" ? @tr("To: {}   CC: {}", root.reader-to, root.reader-cc) : @tr("To: {}", root.reader-to));
                        font-size: Theme.font-s;
                        color: Theme.text-faint;
                        overflow: elide;
                    }
                    if root.attachments.length > 0: HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for attachment[i] in root.attachments: Rectangle {
                            height: 30px;
                            width: min(240px, chip-row.preferred-width);
                            border-radius: Theme.radius-m;
                            background: chip-area.has-hover ? Theme.hover : Theme.field;
                            chip-area := TouchArea { clicked => { root.open-attachment(i, attachment.executable); } }
                            chip-row := HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                Icon { source: @image-url("icons/paperclip.svg"); width: 13px; height: 13px; y: (parent.height - self.height) / 2; tint: attachment.executable ? Theme.close-hover : Theme.text-faint; }
                                Text { text: attachment.name; font-size: Theme.font-s; color: Theme.text; vertical-alignment: center; overflow: elide; }
                                Text { text: attachment.size; font-size: Theme.font-xs; color: Theme.text-faint; vertical-alignment: center; }
                            }
                        }
                    }
                    if root.remote-blocked: Rectangle {
                        height: 30px;
                        border-radius: Theme.radius-m;
                        background: Theme.field;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 4px;
                            spacing: 8px;
                            Icon { source: @image-url("icons/shield.svg"); width: 14px; height: 14px; y: (parent.height - self.height) / 2; }
                            Text {
                                text: root.remote-allowable
                                    ? @tr("Remote images blocked (so the sender cannot tell you opened this)")
                                    : @tr("Tracking images blocked");
                                font-size: Theme.font-s;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            if root.remote-allowable: Rectangle {
                                width: show-label.preferred-width + 20px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                border-radius: Theme.radius-s;
                                background: show-area.has-hover && !root.remote-loading ? Theme.hover : transparent;
                                show-area := TouchArea {
                                    enabled: !root.remote-loading;
                                    clicked => { root.allow-remote(); }
                                }
                                show-label := Text {
                                    text: root.remote-loading ? @tr("Loading…") : @tr("Show");
                                    font-size: Theme.font-s;
                                    font-weight: 600;
                                    color: root.remote-loading ? Theme.text-faint : Theme.accent;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                reader-host := Rectangle {
                    vertical-stretch: 1;
                    if root.use-page-image && root.has-message && !root.composing: page-focus := FocusScope {
                        // Visible-area y of the pointer while dragging (for auto-scroll).
                        property <length> drag-visible-y;
                        key-pressed(event) => {
                            if (event.modifiers.control || event.modifiers.meta) {
                                if (event.text == "c" || event.text == "C") { root.copy-selection(); return accept; }
                                if (event.text == "a" || event.text == "A") { root.select-all(); return accept; }
                            }
                            if (event.text == Key.Escape) { root.clear-selection(); return accept; }
                            return reject;
                        }
                        ContextMenuArea {
                            Menu {
                                MenuItem { title: @tr("Copy"); enabled: root.has-selection; activated => { root.copy-selection(); } }
                                MenuItem { title: @tr("Select all"); activated => { root.select-all(); } }
                            }
                            page-scroll := ScrollView {
                                width: parent.width;
                                height: parent.height;
                                content-width: root.page-width;
                                content-height: root.page-height;
                                Image {
                                    x: 0; y: 0;
                                    width: root.page-width;
                                    height: root.page-height;
                                    source: root.page-image;
                                    image-fit: fill;
                                }
                                page-touch := TouchArea {
                                    x: 0; y: 0;
                                    width: root.page-width;
                                    height: root.page-height;
                                    mouse-cursor:
                                        root.page-cursor == 1 ? MouseCursor.text :
                                        root.page-cursor == 2 ? MouseCursor.pointer :
                                        root.page-cursor == 3 ? MouseCursor.help :
                                        root.page-cursor == 4 ? MouseCursor.not-allowed :
                                        root.page-cursor == 5 ? MouseCursor.crosshair :
                                        root.page-cursor == 6 ? MouseCursor.move :
                                        root.page-cursor == 7 ? MouseCursor.wait :
                                        root.page-cursor == 8 ? MouseCursor.progress :
                                        root.page-cursor == 9 ? MouseCursor.grab :
                                        root.page-cursor == 10 ? MouseCursor.grabbing :
                                        MouseCursor.default;
                                    clicked => { root.page-clicked(self.pressed-x, self.pressed-y); }
                                    pointer-event(e) => {
                                        if (e.button == PointerEventButton.left) {
                                            if (e.kind == PointerEventKind.down) {
                                                page-focus.focus();
                                                page-focus.drag-visible-y = self.mouse-y + page-scroll.content-y;
                                                root.page-pointer(0, self.mouse-x, self.mouse-y);
                                            } else if (e.kind == PointerEventKind.up) {
                                                root.page-pointer(2, self.mouse-x, self.mouse-y);
                                            }
                                        }
                                    }
                                    // `moved` only fires while pressed; track hover via the mouse position.
                                    changed mouse-x => {
                                        page-focus.drag-visible-y = self.mouse-y + page-scroll.content-y;
                                        root.page-pointer-moved(self.mouse-x, self.mouse-y, self.pressed);
                                    }
                                    changed mouse-y => {
                                        page-focus.drag-visible-y = self.mouse-y + page-scroll.content-y;
                                        root.page-pointer-moved(self.mouse-x, self.mouse-y, self.pressed);
                                    }
                                    changed has-hover => { if (!self.has-hover) { root.page-pointer-left(); } }
                                }
                            }
                        }
                        // Auto-scroll while a selection drag is held near the top or bottom edge.
                        Timer {
                            interval: 16ms;
                            running: page-touch.pressed && (page-focus.drag-visible-y < 24px || page-focus.drag-visible-y > page-scroll.visible-height - 24px);
                            triggered => {
                                if (page-focus.drag-visible-y > page-scroll.visible-height - 24px) {
                                    page-scroll.content-y = max(min(0px, page-scroll.visible-height - root.page-height), page-scroll.content-y - 14px);
                                } else {
                                    page-scroll.content-y = min(0px, page-scroll.content-y + 14px);
                                }
                                root.page-pointer-moved(page-touch.mouse-x, page-focus.drag-visible-y - page-scroll.content-y, true);
                            }
                        }
                    }
                    if root.use-fallback && root.has-message && !root.composing: ScrollView {
                        VerticalLayout {
                            padding-left: 40px;
                            padding-right: 40px;
                            padding-top: 8px;
                            Text { text: root.fallback-text; wrap: word-wrap; color: Theme.text; }
                        }
                    }
                    // Inline composer (a compose tab is active)
                    if root.composing: VerticalLayout {
                        padding-left: 40px;
                        padding-right: 40px;
                        padding-top: 26px;
                        padding-bottom: 18px;
                        Text { text: root.compose-title; font-size: Theme.font-xl; font-weight: 600; color: Theme.text; }
                        Rectangle { height: 12px; }
                        Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: @tr("From"); width: 48px; color: Theme.text-faint; font-size: Theme.font-m; vertical-alignment: center; }
                                Text { text: root.compose-from; color: Theme.text-muted; font-size: Theme.font-m; vertical-alignment: center; overflow: elide; }
                            }
                            Divider { y: parent.height - 1px; height: 1px; }
                        }
                        HorizontalLayout {
                            ComposeField { inset: 0px; horizontal-stretch: 1; label: @tr("To"); placeholder: "name@example.com"; text <=> root.compose-to; }
                            Rectangle {
                                width: ccbcc-label.preferred-width + 16px;
                                height: 44px;
                                ccbcc-area := TouchArea { clicked => { root.compose-show-cc-bcc = !root.compose-show-cc-bcc; } }
                                ccbcc-label := Text {
                                    text: "CC / BCC";
                                    font-size: Theme.font-s;
                                    color: root.compose-show-cc-bcc ? Theme.accent : ccbcc-area.has-hover ? Theme.text : Theme.text-faint;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                Divider { y: parent.height - 1px; height: 1px; }
                            }
                        }
                        Rectangle {
                            height: root.compose-show-cc-bcc ? 44px : 0px;
                            clip: true;
                            animate height { duration: 180ms; easing: ease-out; }
                            ComposeField { y: 0px; height: 44px; inset: 0px; label: "CC"; placeholder: @tr("Separate several with commas"); text <=> root.compose-cc; }
                        }
                        Rectangle {
                            height: root.compose-show-cc-bcc ? 44px : 0px;
                            clip: true;
                            animate height { duration: 180ms; easing: ease-out; }
                            ComposeField { y: 0px; height: 44px; inset: 0px; label: "BCC"; placeholder: @tr("Not shown to other recipients"); text <=> root.compose-bcc; }
                        }
                        ComposeField { inset: 0px; label: @tr("Subject"); placeholder: @tr("Subject"); text <=> root.compose-subject; }
                        Rectangle { height: 12px; }
                        RichEditor {
                            vertical-stretch: 1;
                            text <=> root.editor-text;
                            page: root.editor-page;
                            page-height: root.editor-page-height;
                            caret-x: root.editor-caret-x;
                            caret-y: root.editor-caret-y;
                            caret-h: root.editor-caret-h;
                            selection: root.editor-selection;
                            bold: root.editor-bold;
                            italic: root.editor-italic;
                            underline: root.editor-underline;
                            strike: root.editor-strike;
                            block: root.editor-block;
                            sel-serial: root.editor-sel-serial;
                            sel-anchor: root.editor-sel-anchor;
                            sel-cursor: root.editor-sel-cursor;
                            focus-serial: root.editor-focus-serial;
                            edited(t) => { root.editor-edited(t); }
                            command(c) => { root.editor-command(c); }
                            navigate(k, shift) => { root.editor-navigate(k, shift); }
                            enter() => { return root.editor-enter(); }
                            pointer(kind, x, y, clicks, shift) => { root.editor-pointer(kind, x, y, clicks, shift); }
                            caret-moved(a, c) => { root.editor-caret-moved(a, c); }
                            preedit-changed(p) => { root.editor-preedit-changed(p); }
                            resized(w) => { root.editor-resized(w); }
                            focus-gained => { root.editor-focus-gained(); }
                            submit => { if (!root.compose-sending) { root.send-compose(); } }
                        }
                        if root.compose-attachments.length > 0: VerticalLayout {
                            padding-top: 10px;
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                for attachment[i] in root.compose-attachments: Rectangle {
                                    height: 30px;
                                    width: min(240px, att-row.preferred-width);
                                    border-radius: Theme.radius-m;
                                    background: Theme.field;
                                    att-row := HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 4px;
                                        spacing: 6px;
                                        Icon { source: @image-url("icons/paperclip.svg"); width: 13px; height: 13px; y: (parent.height - self.height) / 2; tint: Theme.text-faint; }
                                        Text { text: attachment.name; font-size: Theme.font-s; color: Theme.text; vertical-alignment: center; overflow: elide; }
                                        Text { text: attachment.size; font-size: Theme.font-xs; color: Theme.text-faint; vertical-alignment: center; }
                                        IconButton { icon: @image-url("icons/close.svg"); size: 22px; icon-size: 11px; y: (parent.height - self.height) / 2; clicked => { root.compose-remove-attachment(i); } }
                                    }
                                }
                            }
                        }
                        Rectangle { height: 14px; }
                        HorizontalLayout {
                            spacing: 4px;
                            PrimaryButton {
                                text: root.compose-sending ? @tr("Sending…") : @tr("Send");
                                icon: @image-url("icons/send.svg");
                                has-icon: true;
                                clicked => { if (!root.compose-sending) { root.send-compose(); } }
                            }
                            Rectangle { width: 6px; }
                            IconButton { icon: @image-url("icons/paperclip.svg"); y: 2px; clicked => { root.compose-add-attachment(); } }
                            if root.compose-error != "": Text {
                                text: root.compose-error;
                                font-size: Theme.font-s;
                                color: Theme.close-hover;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            IconButton { icon: @image-url("icons/trash.svg"); y: 2px; clicked => { root.discard-compose(); } }
                        }
                    }
                    // Empty state
                    if !root.has-message && !root.composing: VerticalLayout {
                        alignment: center;
                        spacing: 10px;
                        HorizontalLayout {
                            alignment: center;
                            Icon { source: @image-url("icons/mail-open.svg"); width: 26px; height: 26px; tint: Theme.text-faint.with-alpha(0.7); }
                        }
                        Text { text: @tr("Select a message"); font-size: Theme.font-m; color: Theme.text-faint; horizontal-alignment: center; }
                        Text {
                            text: @tr("j / k move   r reply   a reply all   f forward   e archive   c new");
                            font-size: Theme.font-xs;
                            color: Theme.text-faint.with-alpha(0.8);
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
              }
              }
              Rectangle { horizontal-stretch: 1; min-width: 0px; }
            }
            if root.setup-open: Rectangle {
                background: Theme.bg;
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; min-width: 0px; }
                    AccountSetupView {
                        horizontal-stretch: 0;
                        preferred-width: 680px;
                        min-width: 320px;
                        name <=> root.setup-name;
                        email <=> root.setup-email;
                        password <=> root.setup-password;
                        username <=> root.setup-username;
                        imap-host <=> root.setup-imap-host;
                        imap-port <=> root.setup-imap-port;
                        imap-security <=> root.setup-imap-security;
                        smtp-host <=> root.setup-smtp-host;
                        smtp-port <=> root.setup-smtp-port;
                        smtp-security <=> root.setup-smtp-security;
                        advanced <=> root.setup-advanced;
                        provider: root.setup-provider;
                        note: root.setup-note;
                        error: root.setup-error;
                        busy: root.setup-busy;
                        oauth-provider: root.setup-oauth-provider;
                        password-login: root.setup-password-login;
                        oauth-waiting: root.setup-oauth-waiting;
                        editing: root.setup-editing;
                        email-locked: root.setup-email-locked;
                        email-edited(t) => { root.setup-email-edited(t); }
                        submit => { root.setup-submit(); }
                        oauth-submit => { root.setup-oauth-submit(); }
                        oauth-cancel => { root.setup-oauth-cancel(); }
                    }
                    Rectangle { horizontal-stretch: 1; min-width: 0px; }
                }
            }
            if root.settings-open: Rectangle {
                background: Theme.bg;
                SettingsView {
                    page <=> root.settings-page;
                    theme-mode <=> root.theme-mode;
                    compose-html <=> root.compose-html;
                    default-mail-status: root.default-mail-status;
                    update-status: root.update-status;
                    check-updates <=> root.check-updates;
                    language-names: root.language-names;
                    language-index <=> root.language-index;
                    update-checking: root.update-state == 4;
                    app-version: root.app-version;
                    check-update-now => { root.check-update-now(); }
                    is-default-mail-app: root.is-default-mail-app;
                    make-default-mail-app => { root.make-default-mail-app(); }
                    signature-text <=> root.signature-text;
                    signature-enabled <=> root.signature-enabled;
                    signature-accounts: root.signature-accounts;
                    signature-account <=> root.signature-account;
                    accounts: root.accounts;
                    add-account => { root.open-account-setup(); }
                    remove-account(id) => { root.remove-account(id); }
                    edit-account(id) => { root.edit-account(id); }
                }
            }
            }
        }
    }

    }

    Timer {
        interval: 1ms;
        running: root.pane-fresh;
        triggered => { root.pane-fresh = false; }
    }

    // ───────────── Popups
    account-popup := PopupWindow {
        x: account-button.absolute-position.x;
        y: 44px;
        width: 260px;
        Rectangle {
            property <bool> shown;
            init => { self.shown = true; }
            // Fade only: setting `y` here would take this element out of the popup's
            // layout, leaving it with zero height (no background).
            opacity: self.shown ? 1 : 0;
            animate opacity { duration: 150ms; easing: ease-out; }
            border-radius: Theme.radius-l;
            background: Theme.raised;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000026;
            border-width: 1px;
            border-color: Theme.hairline;
            VerticalLayout {
                padding: 6px;
                spacing: 1px;
                for account[i] in root.accounts: Rectangle {
                    height: 44px;
                    border-radius: Theme.radius-s;
                    background: i == root.active-account ? Theme.selected : row-area.has-hover ? Theme.hover : transparent;
                    row-area := TouchArea { clicked => { root.select-account(i); } }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        Avatar { initials: account.initial; hue: account.hue; size: 24px; y: (parent.height - self.height) / 2; }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: account.name; font-size: Theme.font-s; font-weight: 600; color: Theme.text; overflow: elide; }
                            Text { text: account.email; font-size: Theme.font-xs; color: Theme.text-faint; overflow: elide; }
                        }
                        if i == root.active-account: Text { text: @tr("In use"); font-size: Theme.font-xs; color: Theme.text-faint; vertical-alignment: center; }
                    }
                }
                if root.accounts.length > 0: Rectangle { height: 4px; }
                if root.active-oauth: MenuRow { icon: @image-url("icons/shield.svg"); label: @tr("Sign in again"); clicked => { account-popup.close(); root.reauth(); } }
                MenuRow { icon: @image-url("icons/plus.svg"); label: @tr("Add account"); clicked => { root.open-account-setup(); } }
            }
        }
    }

    mailbox-popup := PopupWindow {
        x: mailbox-button.absolute-position.x;
        y: mailbox-button.absolute-position.y + mailbox-button.height + 4px;
        width: 260px;
        Rectangle {
            property <bool> shown;
            init => { self.shown = true; }
            // Fade only: setting `y` here would take this element out of the popup's
            // layout, leaving it with zero height (no background).
            opacity: self.shown ? 1 : 0;
            animate opacity { duration: 150ms; easing: ease-out; }
            border-radius: Theme.radius-l;
            background: Theme.raised;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000026;
            border-width: 1px;
            border-color: Theme.hairline;
            VerticalLayout {
                padding: 6px;
                spacing: 1px;
                if root.folders.length == 0: Text { text: @tr("No folders yet"); font-size: Theme.font-s; color: Theme.text-faint; height: 32px; vertical-alignment: center; }
                for folder in root.folders: FolderRow {
                    folder: folder;
                    current: folder.path == root.current-folder;
                    clicked => { root.select-folder(folder.path); }
                }
            }
        }
    }

    if root.link-dialog-open: Dialog {
        title: @tr("Open this link?");
        body: @tr("This URL will open in your default browser.");
        detail: root.link-url;
        confirm-label: @tr("Open in browser");
        confirmed => { root.link-dialog-open = false; root.link-confirmed(); }
        cancelled => { root.link-dialog-open = false; }
    }

    if root.exec-warning != "": Dialog {
        title: @tr("This may be a program");
        body: @tr("Opening this kind of file runs a program. Do not save it unless you know the sender.");
        detail: root.exec-warning;
        confirm-label: @tr("Save anyway");
        confirmed => { root.exec-warning = ""; root.save-attachment(-1, false); }
        cancelled => { root.exec-warning = ""; }
    }

    if root.info-dialog-open: Dialog {
        title: @tr("Overlap test");
        body: @tr("Slint draws this dialogue. With Blitz it sits above the document; with a WebView the WebView is hidden while it shows.");
        show-cancel: false;
        confirmed => { root.info-dialog-open = false; }
    }

    // ───────────── Hover tooltips (above everything)
    NoticeLayer { width: root.width; height: root.height; }
    TooltipLayer { width: root.width; height: root.height; }

    // ───────────── Frameless resize handles (not needed on macOS)
    if !root.is-mac && !root.maximised: Rectangle {
        property <length> edge: 5px;
        TouchArea { x: edge; y: 0; width: parent.width - 2 * edge; height: edge; mouse-cursor: n-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(0); } } }
        TouchArea { x: edge; y: parent.height - edge; width: parent.width - 2 * edge; height: edge; mouse-cursor: s-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(1); } } }
        TouchArea { x: parent.width - edge; y: edge; width: edge; height: parent.height - 2 * edge; mouse-cursor: e-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(2); } } }
        TouchArea { x: 0; y: edge; width: edge; height: parent.height - 2 * edge; mouse-cursor: w-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(3); } } }
        TouchArea { x: parent.width - edge; y: 0; width: edge; height: edge; mouse-cursor: ne-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(4); } } }
        TouchArea { x: 0; y: 0; width: edge; height: edge; mouse-cursor: nw-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(5); } } }
        TouchArea { x: parent.width - edge; y: parent.height - edge; width: edge; height: edge; mouse-cursor: se-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(6); } } }
        TouchArea { x: 0; y: parent.height - edge; width: edge; height: edge; mouse-cursor: sw-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.resize-window(7); } } }
    }
}
