// Fuu main window: sidebar / message list / reader.
// The reader body hosts either a host-composited page image (Blitz), a native
// child webview laid over `reader-host`, or the plain-text fallback.

import { ListView, TextEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    Divider, Icon, IconButton, PrimaryButton, SecondaryButton, Avatar, NavItem,
    SectionLabel, SearchField, ComposeField, Dialog,
} from "components.slint";

export struct MessageRow {
    sender: string,
    subject: string,
    preview: string,
    date: string,
    unread: bool,
    initials: string,
    avatar: int,
}

component MessageItem inherits Rectangle {
    in property <MessageRow> message;
    in property <bool> selected;
    callback clicked;
    height: 82px;
    card := Rectangle {
        x: 8px;
        y: 2px;
        width: parent.width - 16px;
        height: parent.height - 4px;
        border-radius: Theme.radius-l;
        background: root.selected ? Theme.selected : area.has-hover ? Theme.hover : transparent;
        animate background { duration: 90ms; }
        area := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
        HorizontalLayout {
            padding: 12px;
            padding-right: 14px;
            spacing: 12px;
            VerticalLayout {
                alignment: start;
                Avatar { initials: root.message.initials; hue: root.message.avatar; size: 34px; }
            }
            VerticalLayout {
                spacing: 3px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.message.sender;
                        overflow: elide;
                        horizontal-stretch: 1;
                        font-size: Theme.font-m;
                        font-weight: root.message.unread ? 650 : 500;
                        color: Theme.text;
                    }
                    Text {
                        text: root.message.date;
                        font-size: Theme.font-xs;
                        color: root.message.unread ? Theme.accent : Theme.text-faint;
                        font-weight: root.message.unread ? 600 : 400;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: root.message.subject;
                        overflow: elide;
                        horizontal-stretch: 1;
                        font-size: Theme.font-m;
                        font-weight: root.message.unread ? 600 : 400;
                        color: root.message.unread ? Theme.text : Theme.text-muted;
                    }
                    if root.message.unread: Rectangle {
                        width: 8px;
                        Rectangle { y: (parent.height - 8px) / 2; width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; }
                    }
                }
                Text {
                    text: root.message.preview;
                    overflow: elide;
                    font-size: Theme.font-s;
                    color: Theme.text-faint;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Fuu";
    preferred-width: 1240px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 540px;
    background: Theme.window-bg;
    default-font-size: 13px;

    in property <[MessageRow]> messages;
    in-out property <int> current-row: -1;
    in property <bool> has-message;
    in property <string> reader-subject;
    in property <string> reader-name;
    in property <string> reader-address;
    in property <string> reader-to: "自分";
    in property <string> reader-initials;
    in property <int> reader-avatar;
    in property <string> reader-date;
    in property <string> status-text;
    in-out property <string> feed-summary;
    in property <string> renderer-error;
    in property <bool> use-fallback;
    // Host-composited renderer (Blitz): the painted page and its logical size.
    in property <bool> use-page-image;
    in property <image> page-image;
    in property <length> page-width;
    in property <length> page-height;
    // Cursor index from fuu_render::Cursor (0 default, 1 text, 2 pointer, ...).
    in property <int> page-cursor;
    in property <bool> has-selection;
    in property <string> renderer-label: "Blitz";
    out property <bool> dark-mode: Theme.dark;
    in property <string> fallback-text;
    in property <string> link-url;
    in-out property <bool> link-dialog-open;
    in-out property <bool> info-dialog-open;
    in-out property <bool> composing;
    in-out property <string> compose-title: "新規メッセージ";
    in-out property <string> compose-to;
    in-out property <string> compose-subject;
    in-out property <string> compose-body;
    in-out property <string> search-text;

    // Geometry of the reader body, in logical pixels relative to the window.
    out property <length> reader-x: reader-host.absolute-position.x;
    out property <length> reader-y: reader-host.absolute-position.y;
    out property <length> reader-w: reader-host.width;
    out property <length> reader-h: reader-host.height;
    // True whenever something drawn by Slint overlaps the reader body.
    out property <bool> reader-covered: link-dialog-open || info-dialog-open || composing || !has-message;

    callback row-selected(int);
    callback page-clicked(length, length);
    callback page-pointer-moved(length, length, bool);
    // phase: 0 = down, 2 = up
    callback page-pointer(int, length, length);
    callback copy-selection();
    callback select-all();
    callback clear-selection();
    callback page-pointer-left();
    callback toggle-renderer();
    callback load-security-sample();
    callback load-cjk-sample();
    callback link-confirmed();
    callback start-compose();
    callback send-compose();
    callback reply(bool);
    callback forward();
    callback archive();
    callback delete();

    HorizontalLayout {
        // ───────────── Sidebar
        Rectangle {
            width: 240px;
            background: Theme.sidebar-bg;
            VerticalLayout {
                padding: 14px;
                padding-top: 16px;
                spacing: 2px;

                // Account switcher
                Rectangle {
                    height: 48px;
                    border-radius: Theme.radius-l;
                    background: account-area.has-hover ? Theme.hover : transparent;
                    account-area := TouchArea { mouse-cursor: pointer; }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 8px;
                        spacing: 10px;
                        Avatar { initials: "F"; hue: 0; size: 30px; y: (parent.height - self.height) / 2; }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text { text: "Fuu"; font-size: Theme.font-m; font-weight: 650; color: Theme.text; }
                            Text { text: "spike@fuu.invalid"; font-size: Theme.font-xs; color: Theme.text-faint; overflow: elide; }
                        }
                        Icon { source: @image-url("icons/chevron-down.svg"); width: 16px; height: 16px; y: (parent.height - self.height) / 2; tint: Theme.text-faint; }
                    }
                }
                Rectangle { height: 12px; }
                PrimaryButton {
                    text: "新規作成";
                    icon: @image-url("icons/compose.svg");
                    has-icon: true;
                    clicked => { root.start-compose(); }
                }
                Rectangle { height: 16px; }

                NavItem { icon: @image-url("icons/inbox.svg"); label: "受信トレイ"; count: "714"; selected: true; }
                NavItem { icon: @image-url("icons/star.svg"); label: "スター付き"; }
                NavItem { icon: @image-url("icons/send.svg"); label: "送信済み"; }
                NavItem { icon: @image-url("icons/draft.svg"); label: "下書き"; count: "2"; strong-count: false; }
                NavItem { icon: @image-url("icons/archive.svg"); label: "アーカイブ"; }
                NavItem { icon: @image-url("icons/trash.svg"); label: "ゴミ箱"; }

                Rectangle { height: 14px; }
                SectionLabel { text: "開発（M0 検査）"; }
                NavItem { icon: @image-url("icons/shield.svg"); label: "セキュリティ検査文書"; clicked => { root.load-security-sample(); } }
                NavItem { icon: @image-url("icons/type.svg"); label: "CJK 表示サンプル"; clicked => { root.load-cjk-sample(); } }
                NavItem { icon: @image-url("icons/overlap.svg"); label: "重なり検査"; clicked => { root.info-dialog-open = true; } }
                NavItem { icon: @image-url("icons/layers.svg"); label: "描画エンジン"; count: root.renderer-label; strong-count: false; clicked => { root.toggle-renderer(); } }

                Rectangle { vertical-stretch: 1; }
                Text { text: root.status-text; wrap: word-wrap; font-size: Theme.font-xs; color: Theme.text-faint; }
            }
        }
        Divider { width: 1px; }

        // ───────────── Message list
        Rectangle {
            width: 370px;
            background: Theme.surface;
            VerticalLayout {
                VerticalLayout {
                    padding: 16px;
                    padding-bottom: 10px;
                    spacing: 12px;
                    HorizontalLayout {
                        height: 32px;
                        spacing: 8px;
                        Text { text: "受信トレイ"; font-size: Theme.font-xl; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                        Text { text: root.messages.length + " 件"; font-size: Theme.font-s; color: Theme.text-faint; vertical-alignment: center; horizontal-stretch: 1; }
                        IconButton { icon: @image-url("icons/more.svg"); y: 0; }
                    }
                    SearchField { text <=> root.search-text; placeholder: "メールを検索"; }
                }
                ListView {
                    for row[i] in root.messages: MessageItem {
                        message: row;
                        selected: i == root.current-row;
                        clicked => {
                            root.current-row = i;
                            root.row-selected(i);
                        }
                    }
                }
            }
        }
        Divider { width: 1px; }

        // ───────────── Reader
        Rectangle {
            background: Theme.surface;
            VerticalLayout {
                // Toolbar
                Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 4px;
                        alignment: start;
                        IconButton { icon: @image-url("icons/reply.svg"); enabled: root.has-message; y: (parent.height - self.height) / 2; clicked => { root.reply(false); } }
                        IconButton { icon: @image-url("icons/reply-all.svg"); enabled: root.has-message; y: (parent.height - self.height) / 2; clicked => { root.reply(true); } }
                        IconButton { icon: @image-url("icons/forward.svg"); enabled: root.has-message; y: (parent.height - self.height) / 2; clicked => { root.forward(); } }
                        Rectangle { width: 1px; height: 20px; y: (parent.height - self.height) / 2; background: Theme.border; }
                        IconButton { icon: @image-url("icons/archive.svg"); enabled: root.has-message; y: (parent.height - self.height) / 2; clicked => { root.archive(); } }
                        IconButton { icon: @image-url("icons/trash.svg"); enabled: root.has-message; y: (parent.height - self.height) / 2; clicked => { root.delete(); } }
                        Rectangle { horizontal-stretch: 1; }
                        IconButton { icon: @image-url("icons/star.svg"); enabled: root.has-message; y: (parent.height - self.height) / 2; }
                        IconButton { icon: @image-url("icons/more.svg"); enabled: root.has-message; y: (parent.height - self.height) / 2; }
                    }
                    Divider { y: parent.height - 1px; height: 1px; }
                }

                // Message header
                if root.has-message: VerticalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-top: 22px;
                    padding-bottom: 16px;
                    spacing: 16px;
                    Text { text: root.reader-subject; font-size: Theme.font-xl; font-weight: 700; wrap: word-wrap; color: Theme.text; }
                    HorizontalLayout {
                        spacing: 12px;
                        Avatar { initials: root.reader-initials; hue: root.reader-avatar; size: 38px; }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: 6px;
                                Text { text: root.reader-name; font-size: Theme.font-m; font-weight: 650; color: Theme.text; overflow: elide; }
                                Text { text: "<" + root.reader-address + ">"; font-size: Theme.font-s; color: Theme.text-faint; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                            }
                            Text { text: "宛先: " + root.reader-to; font-size: Theme.font-s; color: Theme.text-faint; }
                        }
                        Text { text: root.reader-date; font-size: Theme.font-s; color: Theme.text-faint; vertical-alignment: center; }
                    }
                }
                if root.has-message: Divider { height: 1px; }

                reader-host := Rectangle {
                    vertical-stretch: 1;
                    if root.use-page-image && root.has-message: page-focus := FocusScope {
                        // Visible-area y of the pointer while dragging (for auto-scroll).
                        property <length> drag-visible-y;
                        key-pressed(event) => {
                            if (event.modifiers.control || event.modifiers.meta) {
                                if (event.text == "c" || event.text == "C") { root.copy-selection(); return accept; }
                                if (event.text == "a" || event.text == "A") { root.select-all(); return accept; }
                            }
                            if (event.text == Key.Escape) { root.clear-selection(); return accept; }
                            return reject;
                        }
                        ContextMenuArea {
                            Menu {
                                MenuItem { title: "コピー"; enabled: root.has-selection; activated => { root.copy-selection(); } }
                                MenuItem { title: "すべて選択"; activated => { root.select-all(); } }
                            }
                            page-scroll := ScrollView {
                                width: parent.width;
                                height: parent.height;
                                content-width: root.page-width;
                                content-height: root.page-height;
                                Image {
                                    x: 0; y: 0;
                                    width: root.page-width;
                                    height: root.page-height;
                                    source: root.page-image;
                                    image-fit: fill;
                                }
                                page-touch := TouchArea {
                                    x: 0; y: 0;
                                    width: root.page-width;
                                    height: root.page-height;
                                    mouse-cursor:
                                        root.page-cursor == 1 ? MouseCursor.text :
                                        root.page-cursor == 2 ? MouseCursor.pointer :
                                        root.page-cursor == 3 ? MouseCursor.help :
                                        root.page-cursor == 4 ? MouseCursor.not-allowed :
                                        root.page-cursor == 5 ? MouseCursor.crosshair :
                                        root.page-cursor == 6 ? MouseCursor.move :
                                        root.page-cursor == 7 ? MouseCursor.wait :
                                        root.page-cursor == 8 ? MouseCursor.progress :
                                        root.page-cursor == 9 ? MouseCursor.grab :
                                        root.page-cursor == 10 ? MouseCursor.grabbing :
                                        MouseCursor.default;
                                    clicked => { root.page-clicked(self.pressed-x, self.pressed-y); }
                                    pointer-event(e) => {
                                        if (e.button == PointerEventButton.left) {
                                            if (e.kind == PointerEventKind.down) {
                                                page-focus.focus();
                                                page-focus.drag-visible-y = self.mouse-y + page-scroll.content-y;
                                                root.page-pointer(0, self.mouse-x, self.mouse-y);
                                            } else if (e.kind == PointerEventKind.up) {
                                                root.page-pointer(2, self.mouse-x, self.mouse-y);
                                            }
                                        }
                                    }
                                    // `moved` only fires while pressed; track hover via the mouse position.
                                    changed mouse-x => {
                                        page-focus.drag-visible-y = self.mouse-y + page-scroll.content-y;
                                        root.page-pointer-moved(self.mouse-x, self.mouse-y, self.pressed);
                                    }
                                    changed mouse-y => {
                                        page-focus.drag-visible-y = self.mouse-y + page-scroll.content-y;
                                        root.page-pointer-moved(self.mouse-x, self.mouse-y, self.pressed);
                                    }
                                    changed has-hover => { if (!self.has-hover) { root.page-pointer-left(); } }
                                }
                            }
                        }
                        // Auto-scroll while a selection drag is held near the top or bottom edge.
                        Timer {
                            interval: 16ms;
                            running: page-touch.pressed && (page-focus.drag-visible-y < 24px || page-focus.drag-visible-y > page-scroll.visible-height - 24px);
                            triggered => {
                                if (page-focus.drag-visible-y > page-scroll.visible-height - 24px) {
                                    page-scroll.content-y = max(min(0px, page-scroll.visible-height - root.page-height), page-scroll.content-y - 14px);
                                } else {
                                    page-scroll.content-y = min(0px, page-scroll.content-y + 14px);
                                }
                                root.page-pointer-moved(page-touch.mouse-x, page-focus.drag-visible-y - page-scroll.content-y, true);
                            }
                        }
                    }
                    if root.use-fallback && root.has-message: ScrollView {
                        VerticalLayout {
                            padding: 28px;
                            Text { text: root.fallback-text; wrap: word-wrap; color: Theme.text; }
                        }
                    }
                    // Empty state
                    if !root.has-message: VerticalLayout {
                        alignment: center;
                        spacing: 12px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 64px;
                                height: 64px;
                                border-radius: 32px;
                                background: Theme.accent-soft;
                                Icon { source: @image-url("icons/mail-open.svg"); width: 28px; height: 28px; tint: Theme.accent; }
                            }
                        }
                        Text { text: "メールを選択してください"; font-size: Theme.font-l; font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                        Text { text: "一覧から選ぶと、ここに本文が表示されます"; font-size: Theme.font-s; color: Theme.text-faint; horizontal-alignment: center; }
                    }
                }
            }
        }
    }

    // ───────────── Composer sheet
    if root.composing: Rectangle {
        background: Theme.scrim;
        TouchArea { }
        Rectangle {
            width: min(parent.width - 80px, 760px);
            height: min(parent.height - 80px, 620px);
            border-radius: Theme.radius-xl;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 48px;
            drop-shadow-offset-y: 16px;
            drop-shadow-color: #00000045;
            clip: true;
            VerticalLayout {
                Rectangle {
                    height: 52px;
                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 12px;
                        Text { text: root.compose-title; font-size: Theme.font-l; font-weight: 650; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                        IconButton { icon: @image-url("icons/close.svg"); y: (parent.height - self.height) / 2; clicked => { root.composing = false; } }
                    }
                    Divider { y: parent.height - 1px; height: 1px; }
                }
                ComposeField { label: "宛先"; placeholder: "name@example.com"; text <=> root.compose-to; }
                ComposeField { label: "件名"; placeholder: "件名を入力"; text <=> root.compose-subject; }
                Rectangle {
                    vertical-stretch: 1;
                    TextEdit {
                        x: 16px;
                        y: 10px;
                        width: parent.width - 32px;
                        height: parent.height - 16px;
                        text <=> root.compose-body;
                        wrap: word-wrap;
                        font-size: 14px;
                    }
                }
                Divider { height: 1px; }
                Rectangle {
                    height: 60px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 4px;
                        PrimaryButton {
                            text: "送信";
                            icon: @image-url("icons/send.svg");
                            has-icon: true;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.send-compose(); }
                        }
                        Rectangle { width: 8px; }
                        IconButton { icon: @image-url("icons/paperclip.svg"); y: (parent.height - self.height) / 2; }
                        Rectangle { horizontal-stretch: 1; }
                        IconButton { icon: @image-url("icons/trash.svg"); y: (parent.height - self.height) / 2; clicked => { root.composing = false; } }
                    }
                }
            }
        }
    }

    if root.link-dialog-open: Dialog {
        title: "外部リンクを開きますか？";
        body: "既定のブラウザで次の URL を開きます。";
        detail: root.link-url;
        confirm-label: "ブラウザで開く";
        confirmed => { root.link-dialog-open = false; root.link-confirmed(); }
        cancelled => { root.link-dialog-open = false; }
    }

    if root.info-dialog-open: Dialog {
        title: "重なり検査";
        body: "このダイアログは Slint が描画しています。Blitz では文書の上に重なり、WebView では表示中だけ WebView を隠します。";
        show-cancel: false;
        confirmed => { root.info-dialog-open = false; }
    }
}
