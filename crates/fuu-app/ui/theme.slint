// Design tokens. Every colour in the UI comes from here so light and dark stay
// consistent. Follows the OS colour scheme through Palette.
//
// Direction: quiet, minimal, generous whitespace. One surface colour for the whole
// window, panes separated by space rather than lines, accent used sparingly.

import { Palette } from "std-widgets.slint";

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // Surfaces
    out property <color> bg: dark ? #161617 : #fbfbfa;
    out property <color> raised: dark ? #202022 : #ffffff;
    out property <color> field: dark ? #ffffff0d : #00000008;
    out property <color> hairline: dark ? #ffffff12 : #0000000f;
    out property <color> border: dark ? #ffffff1a : #00000014;
    out property <color> scrim: dark ? #00000080 : #1a1a1840;

    // Text
    out property <color> text: dark ? #ededee : #1b1b1a;
    out property <color> text-muted: dark ? #a3a3a8 : #6b6a66;
    out property <color> text-faint: dark ? #6e6e74 : #a3a19b;

    // Accent and states
    out property <color> accent: dark ? #9aa6ff : #3b4fd1;
    out property <color> accent-hover: dark ? #b0b9ff : #3143b4;
    out property <color> on-accent: dark ? #10132b : #ffffff;
    out property <color> hover: dark ? #ffffff0a : #00000006;
    out property <color> pressed: dark ? #ffffff14 : #0000000e;
    out property <color> selected: dark ? #ffffff10 : #0000000b;
    out property <color> close-hover: #c42b1c;

    // Avatar palette (index chosen per sender on the Rust side)
    out property <[color]> avatars: dark
        ? [#5b6cff, #e0679a, #3fb08f, #d9913a, #8f6bdc, #3a9bd9, #c9673f, #6b8f3a]
        : [#4d5fe6, #d24f86, #2f9a7b, #c97f25, #7c58cc, #2d88c4, #b8562f, #5d7f2c];

    // Shape
    out property <length> radius-s: 6px;
    out property <length> radius-m: 8px;
    out property <length> radius-l: 10px;
    out property <length> radius-xl: 14px;

    // Type scale
    out property <length> font-xs: 11px;
    out property <length> font-s: 12px;
    out property <length> font-m: 13px;
    out property <length> font-l: 15px;
    out property <length> font-xl: 22px;
}
